@model FarmFlow.Web.Models.ProductionBatch
@{
    ViewData["Title"] = "Edit Batch - FarmFlow";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', sans-serif; background: #f0f4f0; padding: 40px 20px; }
        .container { max-width: 750px; margin: 0 auto; background: white; border-radius: 16px; padding: 40px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); }
        h1 { color: #1a472a; margin-bottom: 10px; }
        .subtitle { color: #888; margin-bottom: 30px; }
        .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
        .form-group { margin-bottom: 20px; }
        .form-group label { display: block; font-weight: 600; margin-bottom: 5px; color: #333; }
        .form-group label .required { color: #dc3545; }
        .form-group input, .form-group select { width: 100%; padding: 10px 14px; border: 2px solid #e8ece8; border-radius: 8px; font-size: 14px; background: #f8faf8; transition: border-color 0.3s; }
        .form-group input:focus, .form-group select:focus { border-color: #2d6a4f; background: white; outline: none; box-shadow: 0 0 0 3px rgba(45,106,79,0.1); }
        .form-group input[readonly] { background: #e9ecef; cursor: not-allowed; }
        .form-group .text-danger { color: #dc3545; font-size: 13px; margin-top: 4px; display: block; }
        .validation-summary { background: #f8d7da; color: #721c24; padding: 12px 16px; border-radius: 8px; margin-bottom: 20px; border: 1px solid #f5c6cb; }
        .validation-summary ul { margin: 0; padding-left: 20px; }
        .btn-group { display: flex; gap: 10px; margin-top: 20px; flex-wrap: wrap; }
        .btn-submit { background: #1a472a; color: white; border: none; padding: 12px 30px; border-radius: 8px; cursor: pointer; font-weight: 600; font-size: 16px; transition: background 0.3s; }
        .btn-submit:hover { background: #2d6a4f; }
        .btn-cancel { background: #6c757d; color: white; border: none; padding: 12px 30px; border-radius: 8px; cursor: pointer; font-weight: 600; text-decoration: none; display: inline-block; transition: background 0.3s; }
        .btn-cancel:hover { background: #5a6268; }
        .checkbox-group { display: flex; align-items: center; gap: 10px; }
        .checkbox-group input[type="checkbox"] { width: 18px; height: 18px; accent-color: #1a472a; }
        .checkbox-group label { margin: 0; cursor: pointer; }
        @@media (max-width: 600px) { .form-row { grid-template-columns: 1fr; } }
    </style>
</head>
<body>
    <div class="container">
        <h1>✏️ Edit Production Batch</h1>
        <p class="subtitle">Update production batch details.</p>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="validation-summary">
                <ul>
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        <form method="post" asp-action="Edit">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" value="@Model?.Id" />
            <input type="hidden" name="CreatedDateTime" value="@Model?.CreatedDateTime" />

            <!-- Row 1: Batch Code + Farm -->
            <div class="form-row">
                <div class="form-group">
                    <label>Batch Code <span class="required">*</span></label>
                    <input type="text" id="BatchCode" name="BatchCode" value="@Model?.BatchCode" readonly />
                </div>
                <div class="form-group">
                    <label>Farm <span class="required">*</span></label>
                    <select id="FarmId" name="FarmId" required>
                        <option value="">Select Farm...</option>
                        @foreach (var farm in ViewBag.Farms)
                        {
                            <option value="@farm.Id" selected="@(Model?.FarmId == farm.Id)">@farm.FarmName</option>
                        }
                    </select>
                </div>
            </div>

            <!-- Row 2: Crop + Field Name -->
            <div class="form-row">
                <div class="form-group">
                    <label>Crop <span class="required">*</span></label>
                    <select id="CropId" name="CropId" required>
                        <option value="">Select Crop...</option>
                        @foreach (var crop in ViewBag.Crops)
                        {
                            <option value="@crop.Id" selected="@(Model?.CropId == crop.Id)">@crop.CropName (@crop.Variety)</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Field Name</label>
                    <input type="text" id="FieldName" name="FieldName" value="@Model?.FieldName" placeholder="e.g., Field A" />
                </div>
            </div>

            <!-- Row 3: Area + Stage -->
            <div class="form-row">
                <div class="form-group">
                    <label>Field Area (Hectares)</label>
                    <input type="number" id="FieldAreaHectares" name="FieldAreaHectares" value="@Model?.FieldAreaHectares" step="0.01" />
                </div>
                <div class="form-group">
                    <label>Current Stage</label>
                    <select id="CurrentStage" name="CurrentStage">
                        <option value="Planning" selected="@(Model?.CurrentStage == "Planning")">Planning</option>
                        <option value="Planted" selected="@(Model?.CurrentStage == "Planted")">Planted</option>
                        <option value="Growing" selected="@(Model?.CurrentStage == "Growing")">Growing</option>
                        <option value="Harvesting" selected="@(Model?.CurrentStage == "Harvesting")">Harvesting</option>
                        <option value="Completed" selected="@(Model?.CurrentStage == "Completed")">Completed</option>
                    </select>
                </div>
            </div>

            <!-- Row 4: Planting + Expected Harvest -->
            <div class="form-row">
                <div class="form-group">
                    <label>Planting Date</label>
                    <input type="date" id="PlantingDate" name="PlantingDate" value="@(Model?.PlantingDate?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="form-group">
                    <label>Expected Harvest Date</label>
                    <input type="date" id="ExpectedHarvestDate" name="ExpectedHarvestDate" value="@(Model?.ExpectedHarvestDate?.ToString("yyyy-MM-dd"))" />
                </div>
            </div>

            <!-- Row 5: Actual Harvest + Health Status -->
            <div class="form-row">
                <div class="form-group">
                    <label>Actual Harvest Date</label>
                    <input type="date" id="ActualHarvestDate" name="ActualHarvestDate" value="@(Model?.ActualHarvestDate?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="form-group">
                    <label>Crop Health Status</label>
                    <select id="CropHealthStatus" name="CropHealthStatus">
                        <option value="">Select Status...</option>
                        <option value="Excellent" selected="@(Model?.CropHealthStatus == "Excellent")">Excellent</option>
                        <option value="Good" selected="@(Model?.CropHealthStatus == "Good")">Good</option>
                        <option value="Fair" selected="@(Model?.CropHealthStatus == "Fair")">Fair</option>
                        <option value="Poor" selected="@(Model?.CropHealthStatus == "Poor")">Poor</option>
                        <option value="Diseased" selected="@(Model?.CropHealthStatus == "Diseased")">Diseased</option>
                    </select>
                </div>
            </div>

            <!-- Row 6: Predicted + Actual Yield -->
            <div class="form-row">
                <div class="form-group">
                    <label>Predicted Yield (kg)</label>
                    <input type="number" id="PredictedYieldKg" name="PredictedYieldKg" value="@Model?.PredictedYieldKg" step="0.01" />
                </div>
                <div class="form-group">
                    <label>Actual Yield (kg)</label>
                    <input type="number" id="ActualYieldKg" name="ActualYieldKg" value="@Model?.ActualYieldKg" step="0.01" />
                </div>
            </div>

            <!-- Checkbox: Is Active -->
            <div class="form-group">
                <div class="checkbox-group">
                    <input type="checkbox" id="IsActive" name="IsActive" value="true" checked="@(Model?.IsActive == true)" />
                    <label for="IsActive">Active Batch</label>
                </div>
            </div>

            <!-- Buttons -->
            <div class="btn-group">
                <button type="submit" class="btn-submit">
                    <i class="fas fa-save"></i> Update Batch
                </button>
                <a href="/ProductionBatch" class="btn-cancel">
                    <i class="fas fa-times"></i> Cancel
                </a>
            </div>
        </form>
    </div>
</body>
</html>