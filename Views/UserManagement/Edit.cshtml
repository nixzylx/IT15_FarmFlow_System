@model FarmFlow.Web.Models.User
@{
    ViewData["Title"] = "Edit User - FarmFlow";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #f0f4f0;
            min-height: 100vh;
            padding: 40px 20px;
        }
        .container {
            max-width: 600px;
            margin: 0 auto;
            background: white;
            border-radius: 16px;
            padding: 40px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        }
        h1 { color: #1a472a; margin-bottom: 10px; }
        .subtitle { color: #888; margin-bottom: 30px; }
        .form-group { margin-bottom: 20px; }
        .form-group label {
            display: block;
            font-weight: 600;
            margin-bottom: 5px;
            color: #333;
        }
        .form-group input, .form-group select {
            width: 100%;
            padding: 10px 14px;
            border: 2px solid #e8ece8;
            border-radius: 8px;
            font-size: 14px;
            background: #f8faf8;
        }
        .form-group input:focus, .form-group select:focus {
            border-color: #2d6a4f;
            background: white;
            outline: none;
        }
        .form-group .text-danger {
            color: #dc3545;
            font-size: 13px;
            margin-top: 4px;
            display: block;
        }
        .validation-summary {
            background: #f8d7da;
            color: #721c24;
            padding: 12px 16px;
            border-radius: 8px;
            margin-bottom: 20px;
            border: 1px solid #f5c6cb;
        }
        .validation-summary ul { margin: 0; padding-left: 20px; }
        .btn-group {
            display: flex;
            gap: 10px;
            margin-top: 20px;
        }
        .btn-submit {
            background: #1a472a;
            color: white;
            border: none;
            padding: 12px 30px;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
            font-size: 16px;
        }
        .btn-submit:hover { background: #2d6a4f; }
        .btn-cancel {
            background: #6c757d;
            color: white;
            border: none;
            padding: 12px 30px;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
            text-decoration: none;
            display: inline-block;
        }
        .btn-cancel:hover { background: #5a6268; }
        .required { color: #dc3545; }
        .checkbox-group {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .checkbox-group input[type="checkbox"] {
            width: 18px;
            height: 18px;
            accent-color: #1a472a;
        }
        .checkbox-group label {
            margin: 0;
            cursor: pointer;
        }
    </style>
</head>
<body>

    <div class="container">
        <h1>Edit User</h1>
        <p class="subtitle">Update user account details.</p>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="validation-summary">
                <ul>
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        <form method="post" asp-action="Edit">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" value="@Model?.Id" />

            <div class="form-group">
                <label>First Name <span class="required">*</span></label>
                <input type="text" id="FirstName" name="FirstName" value="@Model?.FirstName" required />
                <span class="text-danger">@Html.ValidationMessage("FirstName")</span>
            </div>

            <div class="form-group">
                <label>Last Name <span class="required">*</span></label>
                <input type="text" id="LastName" name="LastName" value="@Model?.LastName" required />
                <span class="text-danger">@Html.ValidationMessage("LastName")</span>
            </div>

            <div class="form-group">
                <label>Email <span class="required">*</span></label>
                <input type="email" id="Email" name="Email" value="@Model?.Email" required />
                <span class="text-danger">@Html.ValidationMessage("Email")</span>
            </div>

            <div class="form-group">
                <label>Username <span class="required">*</span></label>
                <input type="text" id="Username" name="Username" value="@Model?.Username" required readonly style="background:#e9ecef;" />
                <span class="text-danger">@Html.ValidationMessage("Username")</span>
            </div>

            <div class="form-group">
                <label>New Password</label>
                <input type="password" id="password" name="password" placeholder="Leave blank to keep current password" />
                <span class="text-danger">@Html.ValidationMessage("password")</span>
                <small style="color:#999; display:block; margin-top:4px;">Min 6 characters. Leave blank to keep current password.</small>
            </div>

            <div class="form-group">
                <label>Mobile Number</label>
                <input type="text" id="MobileNumber" name="MobileNumber" value="@Model?.MobileNumber" />
            </div>

            <div class="form-group">
                <label>Role <span class="required">*</span></label>
                <select id="RoleId" name="RoleId" required>
                    @foreach (var role in ViewBag.Roles)
                    {
                        if (Model?.RoleId == role.Id)
                        {
                            <option value="@role.Id" selected>@role.Name</option>
                        }
                        else
                        {
                            <option value="@role.Id">@role.Name</option>
                        }
                    }
                </select>
            </div>

            <div class="form-group">
                <div class="checkbox-group">
                    <input type="checkbox" id="IsActive" name="IsActive" value="true" @(Model?.IsActive == true ? "checked" : "") />
                    <label for="IsActive">Account Active</label>
                </div>
            </div>

            <div class="btn-group">
                <button type="submit" class="btn-submit">
                    <i class="fas fa-save"></i> Update User
                </button>
                <a href="/UserManagement" class="btn-cancel">
                    <i class="fas fa-times"></i> Cancel
                </a>
            </div>
        </form>
    </div>

</body>
</html>