@model FarmFlow.Web.Models.Crop
@{
    ViewData["Title"] = "Delete Crop - FarmFlow";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', sans-serif; background: #f0f4f0; padding: 40px 20px; }
        .container { max-width: 600px; margin: 0 auto; background: white; border-radius: 16px; padding: 40px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); }
        .warning-icon { text-align: center; font-size: 64px; color: #dc3545; display: block; margin-bottom: 15px; }
        h1 { color: #dc3545; margin-bottom: 10px; text-align: center; }
        .subtitle { color: #888; margin-bottom: 30px; text-align: center; }
        .crop-details {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 25px;
        }
        .crop-details .detail { display: flex; padding: 8px 0; border-bottom: 1px solid #e9ecef; }
        .crop-details .detail:last-child { border-bottom: none; }
        .crop-details .label { font-weight: 600; width: 120px; color: #495057; }
        .crop-details .value { color: #212529; }
        .warning-text {
            background: #fff3cd;
            color: #856404;
            padding: 12px 16px;
            border-radius: 8px;
            margin-bottom: 20px;
            border: 1px solid #ffeeba;
            text-align: center;
        }
        .btn-group { display: flex; gap: 10px; margin-top: 20px; justify-content: center; }
        .btn-danger { background: #dc3545; color: white; border: none; padding: 12px 30px; border-radius: 8px; cursor: pointer; font-weight: 600; font-size: 16px; }
        .btn-danger:hover { background: #c82333; }
        .btn-cancel { background: #6c757d; color: white; border: none; padding: 12px 30px; border-radius: 8px; cursor: pointer; font-weight: 600; text-decoration: none; display: inline-block; }
        .btn-cancel:hover { background: #5a6268; }
    </style>
</head>
<body>
    <div class="container">
        <span class="warning-icon">⚠️</span>
        <h1>Delete Crop</h1>
        <p class="subtitle">Are you sure you want to delete this crop? This action cannot be undone.</p>

        <div class="warning-text">
            <i class="fas fa-exclamation-triangle"></i> 
            Deleting this crop will permanently remove it from the system.
        </div>

        <div class="crop-details">
            <div class="detail">
                <span class="label">Crop Name:</span>
                <span class="value"><strong>@Model?.CropName</strong></span>
            </div>
            <div class="detail">
                <span class="label">Variety:</span>
                <span class="value">@(Model?.Variety ?? "-")</span>
            </div>
            <div class="detail">
                <span class="label">Category:</span>
                <span class="value">@(Model?.Category ?? "-")</span>
            </div>
            <div class="detail">
                <span class="label">Days to Harvest:</span>
                <span class="value">@(Model?.GrowthDurationDays?.ToString() ?? "-")</span>
            </div>
            <div class="detail">
                <span class="label">Yield (kg/ha):</span>
                <span class="value">@(Model?.ExpectedYieldPerHectare?.ToString("N0") ?? "-")</span>
            </div>
            <div class="detail">
                <span class="label">Status:</span>
                <span class="value">@(Model?.IsActive == true ? "Active" : "Inactive")</span>
            </div>
        </div>

        <div class="btn-group">
            <form method="post" asp-action="DeleteConfirmed">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model?.Id" />
                <button type="submit" class="btn-danger">
                    <i class="fas fa-trash"></i> Yes, Delete
                </button>
            </form>
            <a href="/Crop" class="btn-cancel">
                <i class="fas fa-times"></i> Cancel
            </a>
        </div>
    </div>
</body>
</html>