@model FarmFlow.Web.Models.SalesOrder
@{
    ViewData["Title"] = "New Sales Order";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var customers = ViewBag.Customers as List<FarmFlow.Web.Models.Customer> ?? new();
    var items = ViewBag.Items as List<FarmFlow.Web.Models.InventoryItem> ?? new();
}

<div class="page-header">
    <div class="left">
        <h1><span class="icon">🛒</span> New Sales Order</h1>
    </div>
    <a href="/SalesOrder" class="btn-back">
        <i class="fas fa-arrow-left"></i> Back to List
    </a>
</div>

<div class="card-custom" style="padding:24px;">
    <form asp-action="Create" method="post" id="soForm">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" style="color:#dc3545;margin-bottom:12px;"></div>

        <!-- Header fields -->
        <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:16px;">
            <div>
                <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">SO # *</label>
                <input asp-for="SONumber" value="@ViewBag.NextSONumber" readonly
                       style="width:100%;padding:8px 12px;border:1px solid #ddd;border-radius:6px;background:#f8f9fa;" />
                <span asp-validation-for="SONumber" style="color:#dc3545;font-size:12px;"></span>
            </div>
            <div>
                <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">Customer *</label>
                <select asp-for="CustomerId" style="width:100%;padding:8px 12px;border:1px solid #ddd;border-radius:6px;">
                    <option value="">-- Select Customer --</option>
                    @foreach (var c in customers)
                    {
                        <option value="@c.Id">@c.CompanyName</option>
                    }
                </select>
                <span asp-validation-for="CustomerId" style="color:#dc3545;font-size:12px;"></span>
            </div>
            <div>
                <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">Order Date</label>
                <input asp-for="OrderDate" type="date" value="@DateTime.Now.ToString("yyyy-MM-dd")"
                       style="width:100%;padding:8px 12px;border:1px solid #ddd;border-radius:6px;" />
            </div>
            <div>
                <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">Required Delivery Date</label>
                <input asp-for="RequiredDeliveryDate" type="date"
                       style="width:100%;padding:8px 12px;border:1px solid #ddd;border-radius:6px;" />
            </div>
            <div style="grid-column:1/-1;">
                <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">Delivery Instructions</label>
                <textarea asp-for="DeliveryInstructions" rows="2"
                          style="width:100%;padding:8px 12px;border:1px solid #ddd;border-radius:6px;"></textarea>
            </div>
            <div style="grid-column:1/-1;">
                <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">Notes</label>
                <textarea asp-for="Notes" rows="2"
                          style="width:100%;padding:8px 12px;border:1px solid #ddd;border-radius:6px;"></textarea>
            </div>
        </div>

        <!-- Line items -->
        <h3 style="margin-top:24px;margin-bottom:12px;font-size:15px;">Order Items</h3>
        <div class="table-wrapper" style="margin-bottom:12px;">
            <table class="table-custom" id="itemsTable">
                <thead>
                    <tr>
                        <th style="width:45%;">Item</th>
                        <th style="width:15%;">Quantity</th>
                        <th style="width:20%;">Unit Price (₱)</th>
                        <th style="width:15%;">Line Total</th>
                        <th style="width:5%;"></th>
                    </tr>
                </thead>
                <tbody id="itemsBody">
    <tr class="item-row">
        <td>
            <select name="itemIds" class="item-select" style="width:100%;padding:6px 10px;border:1px solid #ddd;border-radius:6px;">
                <option value="0">-- Select Item --</option>
                @foreach (var item in items)
                {
                    <option value="@item.Id"
                            data-price="@item.SellingPricePerUnit"
                            data-stock="@item.CurrentStock"
                            data-uom="@item.UnitOfMeasure">
                        @item.ItemCode — @item.ItemName (Stock: @item.CurrentStock @item.UnitOfMeasure)
                    </option>
                }
            </select>
        </td>
        <td>
            <input name="quantities" type="number" step="0.001" value="0" class="qty-input"
                   style="width:100%;padding:6px 10px;border:1px solid #ddd;border-radius:6px;" />
            <small class="uom-hint" style="color:var(--text-muted);font-size:11px;"></small>
        </td>
        <td>
            <input name="unitPrices" type="number" step="0.01" value="0" class="price-input"
                   style="width:100%;padding:6px 10px;border:1px solid #ddd;border-radius:6px;" />
        </td>
        <td class="line-total" style="font-weight:600;">₱0.00</td>
        <td style="text-align:center;">
            <button type="button" class="btn-add remove-row" style="background:#dc3545;padding:5px 10px;">
                <i class="fas fa-times"></i>
            </button>
        </td>
    </tr>
</tbody>
            </table>
        </div>

        <button type="button" id="addRowBtn" class="btn-back" style="margin-bottom:20px;">
            <i class="fas fa-plus"></i> Add Another Item
        </button>

        <!-- Totals -->
        <div style="display:flex;justify-content:flex-end;">
            <div style="min-width:280px;padding:16px;background:#f8f9fa;border-radius:8px;">
                <div style="display:flex;justify-content:space-between;margin-bottom:8px;">
                    <span><strong>Subtotal:</strong></span>
                    <span id="subtotalDisplay">₱0.00</span>
                </div>
                <div style="display:flex;justify-content:space-between;padding-top:8px;border-top:1px solid #ddd;">
                    <span><strong>Total:</strong></span>
                    <span id="totalDisplay" style="font-weight:700;color:var(--primary);">₱0.00</span>
                </div>
                <input type="hidden" asp-for="SubtotalAmount" id="SubtotalAmount" />
                <input type="hidden" asp-for="TotalAmount" id="TotalAmount" />
            </div>
        </div>

        <div style="margin-top:24px;display:flex;gap:10px;">
            <button type="submit" class="btn-add"><i class="fas fa-save"></i> Save Sales Order</button>
            <a href="/SalesOrder" class="btn-back"><i class="fas fa-times"></i> Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const itemsBody = document.getElementById('itemsBody');
            const addBtn = document.getElementById('addRowBtn');
            const subtotalInput = document.getElementById('SubtotalAmount');
            const totalInput = document.getElementById('TotalAmount');
            const subtotalDisplay = document.getElementById('subtotalDisplay');
            const totalDisplay = document.getElementById('totalDisplay');

            function recalc() {
                let subtotal = 0;
                itemsBody.querySelectorAll('.item-row').forEach(row => {
                    const qty = parseFloat(row.querySelector('.qty-input').value) || 0;
                    const price = parseFloat(row.querySelector('.price-input').value) || 0;
                    const lineTotal = qty * price;
                    row.querySelector('.line-total').textContent = '₱' + lineTotal.toFixed(2);
                    subtotal += lineTotal;
                });
                subtotalInput.value = subtotal.toFixed(2);
                totalInput.value = subtotal.toFixed(2);
                subtotalDisplay.textContent = '₱' + subtotal.toFixed(2);
                totalDisplay.textContent = '₱' + subtotal.toFixed(2);
            }

            function bindRow(row) {
    row.querySelector('.item-select').addEventListener('change', function () {
        const opt = this.options[this.selectedIndex];
        const price = opt.getAttribute('data-price');
        const uom = opt.getAttribute('data-uom');
        if (price) row.querySelector('.price-input').value = price;
        row.querySelector('.uom-hint').textContent = uom ? `(${uom})` : '';
        recalc();
    });
    row.querySelector('.qty-input').addEventListener('input', recalc);
    row.querySelector('.price-input').addEventListener('input', recalc);
    row.querySelector('.remove-row').addEventListener('click', function () {
        if (itemsBody.querySelectorAll('.item-row').length > 1) {
            row.remove();
            recalc();
        }
    });
}

            itemsBody.querySelectorAll('.item-row').forEach(bindRow);

            addBtn.addEventListener('click', function () {
                const first = itemsBody.querySelector('.item-row');
                const clone = first.cloneNode(true);
                clone.querySelector('.item-select').value = '0';
                clone.querySelector('.qty-input').value = 0;
                clone.querySelector('.price-input').value = 0;
                clone.querySelector('.line-total').textContent = '₱0.00';
                itemsBody.appendChild(clone);
                bindRow(clone);
            });

            recalc();
        });
    </script>
}