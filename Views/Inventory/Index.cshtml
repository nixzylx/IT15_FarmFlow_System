@model IEnumerable<FarmFlow.Web.Models.InventoryItem>
@{
    ViewData["Title"] = "Inventory Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var categories = ViewBag.Categories as List<FarmFlow.Web.Models.Category>;
}

<!-- Header -->
<div class="page-header">
    <div class="left">
        <h1><span class="icon">📦</span> Inventory Management</h1>
    </div>
    <div style="display:flex;gap:10px;flex-wrap:wrap;">
        <a href="/Category" class="btn-back">
            <i class="fas fa-tags"></i> Categories
        </a>
        <a href="/Inventory/Create" class="btn-add">
            <i class="fas fa-plus"></i> Add Item
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert-success-custom">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
    </div>
}

<!-- KPI Cards -->
<div class="kpi-grid">
    <div class="kpi-card">
        <span class="kpi-icon"><i class="fas fa-boxes"></i></span>
        <div class="kpi-label">Total Items</div>
        <div class="kpi-value">@ViewBag.TotalItems</div>
        <div class="kpi-change positive"><i class="fas fa-arrow-up"></i> In Catalog</div>
    </div>
    <div class="kpi-card" style="border-left-color:#e76f51;">
        <span class="kpi-icon" style="color:#e76f51;"><i class="fas fa-exclamation-triangle"></i></span>
        <div class="kpi-label">Low Stock</div>
        <div class="kpi-value" style="color:#e76f51;">@ViewBag.LowStockItems</div>
        <div class="kpi-change negative"><i class="fas fa-arrow-down"></i> Needs Reorder</div>
    </div>
    <div class="kpi-card" style="border-left-color:var(--secondary);">
        <span class="kpi-icon" style="color:var(--secondary);"><i class="fas fa-coins"></i></span>
        <div class="kpi-label">Total Value</div>
        <div class="kpi-value">₱@ViewBag.TotalValue.ToString("N0")</div>
        <div class="kpi-change positive"><i class="fas fa-chart-line"></i> Stock Value</div>
    </div>
    <div class="kpi-card" style="border-left-color:var(--primary-light);">
        <span class="kpi-icon" style="color:var(--primary-light);"><i class="fas fa-tags"></i></span>
        <div class="kpi-label">Categories</div>
        <div class="kpi-value">@(categories?.Count ?? 0)</div>
        <div class="kpi-change positive"><i class="fas fa-th-large"></i> Active Types</div>
    </div>
</div>

<!-- Filter Card -->
<div class="card-custom mb-4">
    <form method="get" asp-action="Index" style="display:flex;gap:12px;flex-wrap:wrap;align-items:end;">
        <div style="flex:1;min-width:200px;">
            <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">Search</label>
            <div class="input-wrapper">
                <i class="fas fa-search icon"></i>
                <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" placeholder="Search by name or code..." />
            </div>
        </div>
        <div style="min-width:200px;">
            <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">Category</label>
            <div class="input-wrapper">
                <i class="fas fa-tags icon"></i>
                <select name="categoryId">
                    <option value="">All Categories</option>
                    @if (categories != null)
                    {
                        foreach (var cat in categories)
                        {
                            <option value="@cat.Id" selected="@(ViewBag.CategoryId == cat.Id)">@cat.Name</option>
                        }
                    }
                </select>
            </div>
        </div>
        <div style="display:flex;gap:8px;">
            <button type="submit" class="btn-add">
                <i class="fas fa-search"></i> Filter
            </button>
            <a href="/Inventory" class="btn-back">
                <i class="fas fa-redo"></i> Reset
            </a>
        </div>
    </form>
</div>

<!-- Items Table -->
<div class="card-custom">
    <div class="table-wrapper">
        <table class="table-custom">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Item Name</th>
                    <th>Category</th>
                    <th>Stock</th>
                    <th>Reorder</th>
                    <th>Unit Price</th>
                    <th>Total Value</th>
                    <th>Status</th>
                    <th style="text-align:center;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        var isLowStock = item.CurrentStock <= (item.ReorderLevel ?? 0);
                        <tr style="@(isLowStock ? "background:#fff8f0;" : "")">
                            <td><span class="badge-status info">@item.ItemCode</span></td>
                            <td>
                                <strong>@item.ItemName</strong>
                                @if (!string.IsNullOrEmpty(item.ItemType))
                                {
                                    <br /><small style="color:var(--text-muted);font-size:11px;">@item.ItemType</small>
                                }
                            </td>
                            <td>
                                @if (item.Category != null)
                                {
                                    <span class="badge-status secondary">@item.Category.Name</span>
                                }
                                else
                                {
                                    <span style="color:var(--text-muted);">-</span>
                                }
                            </td>
                            <td>
                                <strong style="font-size:15px;color:@(isLowStock ? "#e76f51" : "var(--primary-dark)");">
                                    @item.CurrentStock
                                </strong>
                                <small style="color:var(--text-muted);">@item.UnitOfMeasure</small>
                                @if (isLowStock)
                                {
                                    <br /><span class="badge-status inactive" style="font-size:9px;">LOW STOCK</span>
                                }
                            </td>
                            <td>
                                @if (item.ReorderLevel.HasValue)
                                {
                                    <span>@item.ReorderLevel</span>
                                }
                                else
                                {
                                    <span style="color:var(--text-muted);">-</span>
                                }
                            </td>
                            <td>₱@(item.CostPerUnit?.ToString("N2") ?? "-")</td>
                            <td><strong>₱@((item.CurrentStock * (item.CostPerUnit ?? 0)).ToString("N2"))</strong></td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge-status active">Active</span>
                                }
                                else
                                {
                                    <span class="badge-status inactive">Inactive</span>
                                }
                            </td>
                            <td style="text-align:center;white-space:nowrap;">
                                <a href="/Inventory/Details/@item.Id" class="btn-add" style="padding:5px 12px;font-size:13px;background:#17a2b8;" title="View Details">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="/Inventory/AdjustStock/@item.Id" class="btn-add" style="padding:5px 12px;font-size:13px;background:#f4a261;" title="Adjust Stock">
                                    <i class="fas fa-exchange-alt"></i>
                                </a>
                                <a href="/Inventory/Edit/@item.Id" class="btn-add" style="padding:5px 12px;font-size:13px;background:#ffc107;color:#212529;" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a href="/Inventory/Delete/@item.Id" class="btn-add" style="padding:5px 12px;font-size:13px;background:#dc3545;" title="Delete">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9">
                            <div class="empty-state">
                                <i class="fas fa-boxes"></i>
                                <h4>No Inventory Items</h4>
                                <p>Click "Add Item" to create your first item.</p>
                                <a href="/Inventory/Create" class="btn-add" style="margin-top:15px;display:inline-flex;padding:8px 18px;font-size:13px;">
    <i class="fas fa-plus"></i> Add First Item
</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>