@model FarmFlow.Web.Models.Customer
@{
    ViewData["Title"] = "Delete Customer";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var displayName = !string.IsNullOrEmpty(Model.CompanyName)
        ? Model.CompanyName
        : $"{Model.FirstName} {Model.LastName}".Trim();
}

<div class="page-header">
    <div class="left">
        <h1><span class="icon">⚠️</span> Delete Customer</h1>
    </div>
    <a href="/Customer" class="btn-back">
        <i class="fas fa-arrow-left"></i> Back to List
    </a>
</div>

<div class="card-custom" style="padding:24px;max-width:640px;">
    <div style="background:#fff3cd;border-left:4px solid #ffc107;padding:12px 16px;border-radius:6px;margin-bottom:20px;">
        <strong style="color:#856404;">
            <i class="fas fa-exclamation-triangle"></i> Warning
        </strong>
        <p style="margin:6px 0 0 0;color:#856404;font-size:13px;">
            This action cannot be undone. Customers with existing sales orders or quotations cannot be deleted — deactivate them instead.
        </p>
    </div>

    <p style="font-size:15px;margin-bottom:16px;">Are you sure you want to delete this customer?</p>

    <div style="background:#f8f9fa;padding:16px;border-radius:8px;margin-bottom:20px;">
        <div style="margin-bottom:6px;"><strong>Code:</strong> @Model.CustomerCode</div>
        <div style="margin-bottom:6px;"><strong>Name:</strong> @displayName</div>
        <div style="margin-bottom:6px;"><strong>Email:</strong> @(Model.Email ?? "-")</div>
        <div style="margin-bottom:6px;"><strong>Phone:</strong> @(Model.PhoneNumber ?? "-")</div>
        <div style="margin-bottom:6px;"><strong>Type:</strong> @(Model.CustomerType ?? "-")</div>
        <div><strong>Status:</strong> @(Model.IsActive ? "Active" : "Inactive")</div>
    </div>

    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div style="display:flex;gap:10px;">
            <button type="submit" class="btn-add" style="background:#dc3545;"
                    onclick="return confirm('Permanently delete this customer?');">
                <i class="fas fa-trash"></i> Confirm Delete
            </button>
            <a href="/Customer" class="btn-back">
                <i class="fas fa-times"></i> Cancel
            </a>
        </div>
    </form>
</div>