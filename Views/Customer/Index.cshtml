@model IEnumerable<FarmFlow.Web.Models.Customer>
@{
    ViewData["Title"] = "Customer Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var customers = Model.ToList();
}

<div class="page-header">
    <div class="left">
        <h1><span class="icon">👥</span> Customer Management</h1>
    </div>
    <a href="/Customer/Create" class="btn-add">
        <i class="fas fa-plus"></i> Add Customer
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert-success-custom">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
    </div>
}

<!-- KPI Cards -->
<div class="kpi-grid">
    <div class="kpi-card">
        <span class="kpi-icon"><i class="fas fa-users"></i></span>
        <div class="kpi-label">Total Customers</div>
        <div class="kpi-value">@ViewBag.TotalCustomers</div>
        <div class="kpi-change positive"><i class="fas fa-arrow-up"></i> Registered</div>
    </div>
    <div class="kpi-card" style="border-left-color:var(--primary-light);">
        <span class="kpi-icon" style="color:var(--primary-light);"><i class="fas fa-check-circle"></i></span>
        <div class="kpi-label">Active Customers</div>
        <div class="kpi-value">@ViewBag.ActiveCustomers</div>
        <div class="kpi-change positive"><i class="fas fa-check"></i> Buying</div>
    </div>
    <div class="kpi-card" style="border-left-color:#f4a261;">
        <span class="kpi-icon" style="color:#f4a261;"><i class="fas fa-money-bill-wave"></i></span>
        <div class="kpi-label">Total Receivables</div>
        <div class="kpi-value">₱@ViewBag.TotalReceivable.ToString("N0")</div>
        <div class="kpi-change negative"><i class="fas fa-clock"></i> Outstanding</div>
    </div>
    <div class="kpi-card" style="border-left-color:var(--secondary);">
        <span class="kpi-icon" style="color:var(--secondary);"><i class="fas fa-tags"></i></span>
        <div class="kpi-label">Customer Types</div>
        <div class="kpi-value">@customers.Select(c => c.CustomerType).Distinct().Count()</div>
        <div class="kpi-change positive"><i class="fas fa-th-large"></i> Categories</div>
    </div>
</div>

<!-- Filter Card -->
<div class="card-custom mb-4">
    <form method="get" asp-action="Index" style="display:flex;gap:12px;flex-wrap:wrap;align-items:end;">
        <div style="flex:1;min-width:200px;">
            <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">Search</label>
            <div class="input-wrapper">
                <i class="fas fa-search icon"></i>
                <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" placeholder="Search by name, code, or email..." />
            </div>
        </div>
        <div style="min-width:180px;">
            <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">Customer Type</label>
            <div class="input-wrapper">
                <i class="fas fa-filter icon"></i>
                <select name="customerType">
                    <option value="">All Types</option>
                    <option value="Wholesaler" selected="@(ViewBag.CustomerType == "Wholesaler")">Wholesaler</option>
                    <option value="Retailer" selected="@(ViewBag.CustomerType == "Retailer")">Retailer</option>
                    <option value="Exporter" selected="@(ViewBag.CustomerType == "Exporter")">Exporter</option>
                    <option value="Individual" selected="@(ViewBag.CustomerType == "Individual")">Individual</option>
                </select>
            </div>
        </div>
        <div style="display:flex;gap:8px;">
            <button type="submit" class="btn-add"><i class="fas fa-search"></i> Filter</button>
            <a href="/Customer" class="btn-back"><i class="fas fa-redo"></i> Reset</a>
        </div>
    </form>
</div>

<!-- Table -->
<div class="card-custom">
    <div class="table-wrapper">
        <table class="table-custom">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Company / Name</th>
                    <th>Type</th>
                    <th>Contact</th>
                    <th>Email</th>
                    <th>Terms</th>
                    <th>Balance</th>
                    <th>Status</th>
                    <th style="text-align:center;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (customers.Any())
                {
                    foreach (var c in customers)
                    {
                        <tr>
                            <td><span class="badge-status info">@c.CustomerCode</span></td>
                            <td>
                                <strong>@(c.CompanyName ?? $"{c.FirstName} {c.LastName}")</strong>
                            </td>
                            <td><span class="badge-status secondary">@c.CustomerType</span></td>
                            <td>@(c.PhoneNumber ?? "-")</td>
                            <td>@(c.Email ?? "-")</td>
                            <td>@(c.PaymentTerms ?? "-")</td>
                            <td>
                                <strong style="color:@((c.CurrentBalance ?? 0) > 0 ? "#e76f51" : "var(--primary)");">
                                    ₱@((c.CurrentBalance ?? 0).ToString("N2"))
                                </strong>
                            </td>
                            <td>
                                @if (c.IsActive)
                                {
                                    <span class="badge-status active">Active</span>
                                }
                                else
                                {
                                    <span class="badge-status inactive">Inactive</span>
                                }
                            </td>
                            <td style="text-align:center;white-space:nowrap;">
                                <a href="/Customer/Details/@c.Id" class="btn-add" style="padding:5px 10px;font-size:13px;background:#17a2b8;" title="View">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="/Customer/Edit/@c.Id" class="btn-add" style="padding:5px 10px;font-size:13px;background:#ffc107;color:#212529;" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a href="/Customer/Delete/@c.Id" class="btn-add" style="padding:5px 10px;font-size:13px;background:#dc3545;" title="Delete">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9">
                            <div class="empty-state">
                                <i class="fas fa-users"></i>
                                <h4>No Customers Found</h4>
                                <p>Click "Add Customer" to register your first customer.</p>
                                <a href="/Customer/Create" class="btn-add" style="margin-top:12px;display:inline-flex;padding:8px 20px;font-size:13px;">
                                    <i class="fas fa-plus"></i> Add First Customer
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>