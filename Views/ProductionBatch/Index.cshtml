@model IEnumerable<FarmFlow.Web.Models.ProductionBatch>
@{
    ViewData["Title"] = "Production Batches";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var batches = Model.ToList();
}

<!-- Header -->
<div class="page-header">
    <div class="left">
        <h1><span class="icon">🌾</span> Production Batches</h1>
    </div>
    <a href="/ProductionBatch/Create" class="btn-add">
        <i class="fas fa-plus"></i> Add Batch
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert-success-custom">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
    </div>
}

<!-- KPI Cards -->
<div class="kpi-grid">
    <div class="kpi-card">
        <span class="kpi-icon"><i class="fas fa-clipboard-list"></i></span>
        <div class="kpi-label">Total Batches</div>
        <div class="kpi-value">@batches.Count</div>
        <div class="kpi-change positive"><i class="fas fa-arrow-up"></i> All Time</div>
    </div>
    <div class="kpi-card" style="border-left-color:var(--primary-light);">
        <span class="kpi-icon" style="color:var(--primary-light);"><i class="fas fa-check-circle"></i></span>
        <div class="kpi-label">Active</div>
        <div class="kpi-value">@batches.Count(b => b.IsActive)</div>
        <div class="kpi-change positive"><i class="fas fa-check"></i> In Progress</div>
    </div>
    <div class="kpi-card" style="border-left-color:var(--secondary);">
        <span class="kpi-icon" style="color:var(--secondary);"><i class="fas fa-seedling"></i></span>
        <div class="kpi-label">Growing</div>
        <div class="kpi-value">@batches.Count(b => b.CurrentStage == "Growing")</div>
        <div class="kpi-change positive"><i class="fas fa-leaf"></i> Active Crops</div>
    </div>
    <div class="kpi-card" style="border-left-color:#f4a261;">
        <span class="kpi-icon" style="color:#f4a261;"><i class="fas fa-shopping-basket"></i></span>
        <div class="kpi-label">Harvesting</div>
        <div class="kpi-value">@batches.Count(b => b.CurrentStage == "Harvesting" || b.CurrentStage == "Completed")</div>
        <div class="kpi-change positive">Ready/Completed</div>
    </div>
</div>

<!-- Filter Card -->
<div class="card-custom mb-4">
    <form method="get" asp-action="Index" style="display:flex;gap:12px;flex-wrap:wrap;align-items:end;">
        <div style="flex:1;min-width:200px;">
            <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">Search</label>
            <div class="input-wrapper">
                <i class="fas fa-search icon"></i>
                <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" placeholder="Search by batch code..." />
            </div>
        </div>
        <div style="display:flex;gap:8px;">
            <button type="submit" class="btn-add">
                <i class="fas fa-search"></i> Filter
            </button>
            <a href="/ProductionBatch" class="btn-back">
                <i class="fas fa-redo"></i> Reset
            </a>
        </div>
    </form>
</div>

<!-- Table -->
<div class="card-custom">
    <div class="table-wrapper">
        <table class="table-custom">
            <thead>
                <tr>
                    <th>Batch Code</th>
                    <th>Farm</th>
                    <th>Crop</th>
                    <th>Field</th>
                    <th>Area (ha)</th>
                    <th>Planted</th>
                    <th>Harvest</th>
                    <th>Stage</th>
                    <th>Health</th>
                    <th>Status</th>
                    <th style="text-align:center;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (batches.Any())
                {
                    foreach (var batch in batches)
                    {
                        var stageClass = batch.CurrentStage switch
                        {
                            "Planning" => "badge-status secondary",
                            "Planted" => "badge-status info",
                            "Growing" => "badge-status primary",
                            "Harvesting" => "badge-status warning",
                            "Completed" => "badge-status active",
                            _ => "badge-status secondary"
                        };

                        var healthClass = batch.CropHealthStatus switch
                        {
                            "Excellent" => "badge-status active",
                            "Good" => "badge-status info",
                            "Fair" => "badge-status warning",
                            "Poor" => "badge-status inactive",
                            "Diseased" => "badge-status inactive",
                            _ => "badge-status secondary"
                        };

                        <tr>
                            <td><strong>@batch.BatchCode</strong></td>
                            <td>@batch.Farm?.FarmName</td>
                            <td>@batch.Crop?.CropName</td>
                            <td>@(batch.FieldName ?? "-")</td>
                            <td>@(batch.FieldAreaHectares?.ToString("N2") ?? "-")</td>
                            <td>@(batch.PlantingDate?.ToString("MMM dd, yy") ?? "-")</td>
                            <td>@(batch.ExpectedHarvestDate?.ToString("MMM dd, yy") ?? "-")</td>
                            <td><span class="@stageClass">@(batch.CurrentStage ?? "Planning")</span></td>
                            <td><span class="@healthClass">@(batch.CropHealthStatus ?? "-")</span></td>
                            <td>
                                @if (batch.IsActive)
                                {
                                    <span class="badge-status active">Active</span>
                                }
                                else
                                {
                                    <span class="badge-status inactive">Inactive</span>
                                }
                            </td>
                            <td style="text-align:center;white-space:nowrap;">
                                <a href="/ProductionBatch/Details/@batch.Id" class="btn-add" style="padding:5px 10px;font-size:13px;background:#17a2b8;" title="View">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="/ProductionBatch/Edit/@batch.Id" class="btn-add" style="padding:5px 10px;font-size:13px;background:#ffc107;color:#212529;" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a href="/ProductionBatch/Delete/@batch.Id" class="btn-add" style="padding:5px 10px;font-size:13px;background:#dc3545;" title="Delete">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="11">
                            <div class="empty-state">
                                <i class="fas fa-seedling"></i>
                                <h4>No Production Batches</h4>
                                <p>Click "Add Batch" to start your first planting cycle.</p>
                                <a href="/ProductionBatch/Create" class="btn-add" style="margin-top:12px;display:inline-flex;padding:8px 20px;font-size:13px;">
                                    <i class="fas fa-plus"></i> Start First Batch
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>