@model IEnumerable<FarmFlow.Web.Models.Payment>
@{
    ViewData["Title"] = "Payment History";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var payments = Model.ToList();
}

<!-- Header -->
<div class="page-header">
    <div class="left">
        <h1><span class="icon">💳</span> Payments</h1>
    </div>
    <div style="display:flex;gap:8px;">
        <a href="/Payment/Create?type=Customer" class="btn-add">
            <i class="fas fa-plus"></i> Customer Payment
        </a>
        <a href="/Payment/Create?type=Supplier" class="btn-add" style="background:var(--secondary);">
            <i class="fas fa-plus"></i> Supplier Payment
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert-success-custom">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert-danger-custom">
        <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
    </div>
}

<!-- KPI Cards -->
<div class="kpi-grid">
    <div class="kpi-card">
        <span class="kpi-icon"><i class="fas fa-credit-card"></i></span>
        <div class="kpi-label">Total Payments</div>
        <div class="kpi-value">@ViewBag.TotalCount</div>
        <div class="kpi-change positive">Records</div>
    </div>
    <div class="kpi-card" style="border-left-color:#28a745;">
        <span class="kpi-icon" style="color:#28a745;"><i class="fas fa-arrow-down"></i></span>
        <div class="kpi-label">Received (Customer)</div>
        <div class="kpi-value">₱@ViewBag.CustomerTotal.ToString("N0")</div>
        <div class="kpi-change positive">Inflow</div>
    </div>
    <div class="kpi-card" style="border-left-color:#dc3545;">
        <span class="kpi-icon" style="color:#dc3545;"><i class="fas fa-arrow-up"></i></span>
        <div class="kpi-label">Paid (Supplier)</div>
        <div class="kpi-value">₱@ViewBag.SupplierTotal.ToString("N0")</div>
        <div class="kpi-change negative">Outflow</div>
    </div>
    <div class="kpi-card" style="border-left-color:var(--secondary);">
        <span class="kpi-icon" style="color:var(--secondary);"><i class="fas fa-coins"></i></span>
        <div class="kpi-label">Net Cash Flow</div>
        <div class="kpi-value">₱@((ViewBag.CustomerTotal - ViewBag.SupplierTotal).ToString("N0"))</div>
        <div class="kpi-change positive">Net</div>
    </div>
</div>

<!-- Filter Card -->
<div class="card-custom mb-4">
    <form method="get" asp-action="Index" style="display:flex;gap:12px;flex-wrap:wrap;align-items:end;">
        <div style="flex:1;min-width:200px;">
            <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">Search</label>
            <div class="input-wrapper">
                <i class="fas fa-search icon"></i>
                <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" placeholder="Search by payment # or reference..." />
            </div>
        </div>
        <div style="min-width:160px;">
            <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">Type</label>
            <select name="paymentType" style="width:100%;padding:8px 12px;border:1px solid #ddd;border-radius:6px;">
                <option value="">All Types</option>
                <option value="Customer" selected="@(ViewBag.PaymentType == "Customer")">Customer</option>
                <option value="Supplier" selected="@(ViewBag.PaymentType == "Supplier")">Supplier</option>
            </select>
        </div>
        <div style="min-width:140px;">
            <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">From</label>
            <input type="date" name="fromDate" value="@ViewBag.FromDate"
                   style="width:100%;padding:8px 12px;border:1px solid #ddd;border-radius:6px;" />
        </div>
        <div style="min-width:140px;">
            <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">To</label>
            <input type="date" name="toDate" value="@ViewBag.ToDate"
                   style="width:100%;padding:8px 12px;border:1px solid #ddd;border-radius:6px;" />
        </div>
        <div style="display:flex;gap:8px;">
            <button type="submit" class="btn-add"><i class="fas fa-search"></i> Filter</button>
            <a href="/Payment" class="btn-back"><i class="fas fa-redo"></i> Reset</a>
        </div>
    </form>
</div>

<!-- Table -->
<div class="card-custom">
    <div class="table-wrapper">
        <table class="table-custom">
            <thead>
                <tr>
                    <th>Payment #</th>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Reference</th>
                    <th>Method</th>
                    <th style="text-align:right;">Amount</th>
                    <th>Recorded By</th>
                    <th style="text-align:center;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (payments.Any())
                {
                    foreach (var p in payments)
                    {
                        var link = p.PaymentType == "Customer"
                            ? p.SalesOrder?.Customer?.CompanyName
                            : p.PurchaseOrder?.Supplier?.CompanyName;
                        var refNumber = p.PaymentType == "Customer"
                            ? p.SalesOrder?.SONumber
                            : p.PurchaseOrder?.PONumber;

                        <tr>
                            <td><span class="badge-status info">@p.PaymentNumber</span></td>
                            <td>@p.PaymentDate.ToString("MMM dd, yyyy")</td>
                            <td>
                                @if (p.PaymentType == "Customer")
                                {
                                    <span class="badge-status active">Customer</span>
                                }
                                else
                                {
                                    <span class="badge-status warning">Supplier</span>
                                }
                            </td>
                            <td>
                                <div><strong>@(refNumber ?? "-")</strong></div>
                                <div style="font-size:12px;color:var(--text-muted);">@(link ?? "-")</div>
                            </td>
                            <td>@p.PaymentMethod</td>
                            <td style="text-align:right;"><strong>₱@p.Amount.ToString("N2")</strong></td>
                            <td>@(p.CreatedByUser?.FirstName ?? "-")</td>
                            <td style="text-align:center;white-space:nowrap;">
                                <a href="/Payment/Details/@p.Id" class="btn-add"
                                   style="padding:5px 12px;font-size:13px;background:#17a2b8;" title="View">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="/Payment/Delete/@p.Id" class="btn-add"
                                   style="padding:5px 12px;font-size:13px;background:#dc3545;" title="Delete">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8">
                            <div class="empty-state">
                                <i class="fas fa-credit-card"></i>
                                <h4>No Payments Recorded</h4>
                                <p>Record a customer or supplier payment to get started.</p>
                                <div style="display:flex;gap:8px;justify-content:center;margin-top:12px;">
                                    <a href="/Payment/Create?type=Customer" class="btn-add" style="padding:8px 20px;font-size:13px;">
                                        <i class="fas fa-plus"></i> Customer Payment
                                    </a>
                                    <a href="/Payment/Create?type=Supplier" class="btn-add" style="padding:8px 20px;font-size:13px;background:var(--secondary);">
                                        <i class="fas fa-plus"></i> Supplier Payment
                                    </a>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>