@model IEnumerable<FarmFlow.Web.Models.ExpenseCategory>
@{
    ViewData["Title"] = "Expense Categories";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var categories = Model.ToList();
}

<!-- Header -->
<div class="page-header">
    <div class="left">
        <h1><span class="icon">🏷️</span> Expense Categories</h1>
    </div>
    <a href="/ExpenseCategory/Create" class="btn-add">
        <i class="fas fa-plus"></i> New Category
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert-success-custom">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert-danger-custom">
        <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
    </div>
}

<!-- KPI Cards -->
<div class="kpi-grid">
    <div class="kpi-card">
        <span class="kpi-icon"><i class="fas fa-tags"></i></span>
        <div class="kpi-label">Total Categories</div>
        <div class="kpi-value">@ViewBag.TotalCategories</div>
        <div class="kpi-change positive"><i class="fas fa-arrow-up"></i> Defined</div>
    </div>
    <div class="kpi-card" style="border-left-color:var(--primary-light);">
        <span class="kpi-icon" style="color:var(--primary-light);"><i class="fas fa-check-circle"></i></span>
        <div class="kpi-label">Active</div>
        <div class="kpi-value">@ViewBag.ActiveCategories</div>
        <div class="kpi-change positive">In Use</div>
    </div>
    <div class="kpi-card" style="border-left-color:var(--secondary);">
        <span class="kpi-icon" style="color:var(--secondary);"><i class="fas fa-receipt"></i></span>
        <div class="kpi-label">Total Expenses</div>
        <div class="kpi-value">@ViewBag.TotalExpenses</div>
        <div class="kpi-change positive">Recorded</div>
    </div>
    <div class="kpi-card" style="border-left-color:#f4a261;">
        <span class="kpi-icon" style="color:#f4a261;"><i class="fas fa-money-bill-wave"></i></span>
        <div class="kpi-label">Total Amount</div>
        <div class="kpi-value">₱@ViewBag.TotalExpenseAmount.ToString("N0")</div>
        <div class="kpi-change negative">All Time</div>
    </div>
</div>

<!-- Filter Card -->
<div class="card-custom mb-4">
    <form method="get" asp-action="Index" style="display:flex;gap:12px;flex-wrap:wrap;align-items:end;">
        <div style="flex:1;min-width:200px;">
            <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">Search</label>
            <div class="input-wrapper">
                <i class="fas fa-search icon"></i>
                <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" placeholder="Search by name or description..." />
            </div>
        </div>
        <div style="display:flex;gap:8px;">
            <button type="submit" class="btn-add"><i class="fas fa-search"></i> Filter</button>
            <a href="/ExpenseCategory" class="btn-back"><i class="fas fa-redo"></i> Reset</a>
        </div>
    </form>
</div>

<!-- Table -->
<div class="card-custom">
    <div class="table-wrapper">
        <table class="table-custom">
            <thead>
                <tr>
                    <th style="width:60px;">#</th>
                    <th>Category Name</th>
                    <th>Description</th>
                    <th style="text-align:right;">Expenses Count</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th style="text-align:center;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (categories.Any())
                {
                    foreach (var c in categories)
                    {
                        <tr>
                            <td>@c.Id</td>
                            <td><strong>@c.Name</strong></td>
                            <td>@(string.IsNullOrEmpty(c.Description) ? "-" : c.Description)</td>
                            <td style="text-align:right;">@(c.Expenses?.Count ?? 0)</td>
                            <td>
                                @if (c.IsActive)
                                {
                                    <span class="badge-status active">Active</span>
                                }
                                else
                                {
                                    <span class="badge-status inactive">Inactive</span>
                                }
                            </td>
                            <td>@c.CreatedDateTime.ToString("MMM dd, yyyy")</td>
                            <td style="text-align:center;white-space:nowrap;">
                                <a href="/ExpenseCategory/Edit/@c.Id" class="btn-add"
                                   style="padding:5px 12px;font-size:13px;background:#ffc107;color:#212529;" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a href="/ExpenseCategory/Delete/@c.Id" class="btn-add"
                                   style="padding:5px 12px;font-size:13px;background:#dc3545;" title="Delete">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7">
                            <div class="empty-state">
                                <i class="fas fa-tags"></i>
                                <h4>No Categories Found</h4>
                                <p>Click "New Category" to define your first expense category.</p>
                                <a href="/ExpenseCategory/Create" class="btn-add" style="margin-top:12px;display:inline-flex;padding:8px 20px;font-size:13px;">
                                    <i class="fas fa-plus"></i> New Category
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>