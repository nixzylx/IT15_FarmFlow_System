@model FarmFlow.Web.Models.Payment
@{
    ViewData["Title"] = "Delete Payment";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool isCustomer = Model.PaymentType == "Customer";
    var link = isCustomer
        ? Model.SalesOrder?.Customer?.CompanyName
        : Model.PurchaseOrder?.Supplier?.CompanyName;
}

<div class="page-header">
    <div class="left">
        <h1><span class="icon">⚠️</span> Delete Payment</h1>
    </div>
    <a href="/Payment" class="btn-back">
        <i class="fas fa-arrow-left"></i> Back to List
    </a>
</div>

<div class="card-custom" style="padding:24px;max-width:640px;">
    <div class="alert-danger-custom" style="background:#fff3cd;color:#856404;margin-bottom:20px;">
        <i class="fas fa-exclamation-triangle"></i>
        <div>
            <strong>Warning:</strong> Deleting a payment will automatically recompute the linked Sales Order's Payment Status.
        </div>
    </div>

    <p style="font-size:15px;margin-bottom:16px;">Are you sure you want to delete this payment?</p>

    <div style="background:#f8f9fa;padding:16px;border-radius:8px;margin-bottom:20px;">
        <div style="margin-bottom:6px;"><strong>Payment #:</strong> @Model.PaymentNumber</div>
        <div style="margin-bottom:6px;"><strong>Date:</strong> @Model.PaymentDate.ToString("MMM dd, yyyy")</div>
        <div style="margin-bottom:6px;"><strong>Type:</strong> @Model.PaymentType</div>
        <div style="margin-bottom:6px;"><strong>Amount:</strong> ₱@Model.Amount.ToString("N2")</div>
        <div><strong>Linked To:</strong> @(link ?? "-")</div>
    </div>

    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div style="display:flex;gap:10px;">
            <button type="submit" class="btn-add" style="background:#dc3545;"
                    onclick="return confirm('Permanently delete this payment?');">
                <i class="fas fa-trash"></i> Confirm Delete
            </button>
            <a href="/Payment" class="btn-back">
                <i class="fas fa-times"></i> Cancel
            </a>
        </div>
    </form>
</div>