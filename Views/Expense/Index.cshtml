@model IEnumerable<FarmFlow.Web.Models.Expense>
@{
    ViewData["Title"] = "Expense Tracking";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var expenses = Model.ToList();
    var categories = ViewBag.Categories as List<FarmFlow.Web.Models.ExpenseCategory> ?? new();
}

<!-- Header -->
<div class="page-header">
    <div class="left">
        <h1><span class="icon">🧾</span> Expense Tracking</h1>
    </div>
    <a href="/Expense/Create" class="btn-add">
        <i class="fas fa-plus"></i> New Expense
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert-success-custom">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert-danger-custom">
        <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
    </div>
}

<!-- KPI Cards -->
<div class="kpi-grid">
    <div class="kpi-card">
        <span class="kpi-icon"><i class="fas fa-receipt"></i></span>
        <div class="kpi-label">Total Expenses</div>
        <div class="kpi-value">@ViewBag.TotalCount</div>
        <div class="kpi-change positive"><i class="fas fa-arrow-up"></i> Records</div>
    </div>
    <div class="kpi-card" style="border-left-color:#f4a261;">
        <span class="kpi-icon" style="color:#f4a261;"><i class="fas fa-hourglass-half"></i></span>
        <div class="kpi-label">Pending Approval</div>
        <div class="kpi-value">@ViewBag.PendingCount</div>
        <div class="kpi-change negative">₱@ViewBag.PendingAmount.ToString("N0")</div>
    </div>
    <div class="kpi-card" style="border-left-color:#28a745;">
        <span class="kpi-icon" style="color:#28a745;"><i class="fas fa-check-circle"></i></span>
        <div class="kpi-label">Approved</div>
        <div class="kpi-value">@ViewBag.ApprovedCount</div>
        <div class="kpi-change positive">Ready to Pay</div>
    </div>
    <div class="kpi-card" style="border-left-color:var(--secondary);">
        <span class="kpi-icon" style="color:var(--secondary);"><i class="fas fa-money-bill-wave"></i></span>
        <div class="kpi-label">Total Amount</div>
        <div class="kpi-value">₱@ViewBag.TotalAmount.ToString("N0")</div>
        <div class="kpi-change positive">Filtered</div>
    </div>
</div>

<!-- Filter Card -->
<div class="card-custom mb-4">
    <form method="get" asp-action="Index" style="display:flex;gap:12px;flex-wrap:wrap;align-items:end;">
        <div style="flex:1;min-width:200px;">
            <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">Search</label>
            <div class="input-wrapper">
                <i class="fas fa-search icon"></i>
                <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" placeholder="Search by EXP #, vendor, description..." />
            </div>
        </div>
        <div style="min-width:150px;">
            <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">Status</label>
            <select name="status" style="width:100%;padding:8px 12px;border:1px solid #ddd;border-radius:6px;">
                <option value="">All</option>
                <option value="Pending" selected="@(ViewBag.Status == "Pending")">Pending</option>
                <option value="Approved" selected="@(ViewBag.Status == "Approved")">Approved</option>
                <option value="Rejected" selected="@(ViewBag.Status == "Rejected")">Rejected</option>
                <option value="Paid" selected="@(ViewBag.Status == "Paid")">Paid</option>
            </select>
        </div>
        <div style="min-width:160px;">
            <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">Category</label>
            <select name="categoryId" style="width:100%;padding:8px 12px;border:1px solid #ddd;border-radius:6px;">
                <option value="">All Categories</option>
                @foreach (var cat in categories)
                {
                    <option value="@cat.Id" selected="@(ViewBag.CategoryId == cat.Id)">@cat.Name</option>
                }
            </select>
        </div>
        <div style="min-width:140px;">
            <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">From</label>
            <input type="date" name="fromDate" value="@ViewBag.FromDate"
                   style="width:100%;padding:8px 12px;border:1px solid #ddd;border-radius:6px;" />
        </div>
        <div style="min-width:140px;">
            <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">To</label>
            <input type="date" name="toDate" value="@ViewBag.ToDate"
                   style="width:100%;padding:8px 12px;border:1px solid #ddd;border-radius:6px;" />
        </div>
        <div style="display:flex;gap:8px;">
            <button type="submit" class="btn-add"><i class="fas fa-search"></i> Filter</button>
            <a href="/Expense" class="btn-back"><i class="fas fa-redo"></i> Reset</a>
        </div>
    </form>
</div>

<!-- Table -->
<div class="card-custom">
    <div class="table-wrapper">
        <table class="table-custom">
            <thead>
                <tr>
                    <th>EXP #</th>
                    <th>Date</th>
                    <th>Category</th>
                    <th>Description</th>
                    <th>Vendor</th>
                    <th style="text-align:right;">Amount</th>
                    <th>Status</th>
                    <th>Created By</th>
                    <th style="text-align:center;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (expenses.Any())
                {
                    foreach (var e in expenses)
                    {
                        var statusClass = e.Status switch
                        {
                            "Pending" => "warning",
                            "Approved" => "active",
                            "Rejected" => "inactive",
                            "Paid" => "info",
                            _ => "secondary"
                        };

                        <tr>
                            <td><span class="badge-status info">@e.ExpenseNumber</span></td>
                            <td>@e.ExpenseDate.ToString("MMM dd, yyyy")</td>
                            <td>@(e.ExpenseCategory?.Name ?? "-")</td>
                            <td>@(string.IsNullOrEmpty(e.Description) ? "-" : e.Description)</td>
                            <td>@(string.IsNullOrEmpty(e.Vendor) ? "-" : e.Vendor)</td>
                            <td style="text-align:right;"><strong>₱@e.Amount.ToString("N2")</strong></td>
                            <td><span class="badge-status @statusClass">@e.Status</span></td>
                            <td>@(e.CreatedByUser?.FirstName ?? "-")</td>
                            <td style="text-align:center;white-space:nowrap;">
                                <a href="/Expense/Details/@e.Id" class="btn-add"
                                   style="padding:5px 12px;font-size:13px;background:#17a2b8;" title="View">
                                    <i class="fas fa-eye"></i>
                                </a>
                                @if (e.Status != "Approved" && e.Status != "Paid")
                                {
                                    <a href="/Expense/Edit/@e.Id" class="btn-add"
                                       style="padding:5px 12px;font-size:13px;background:#ffc107;color:#212529;" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a href="/Expense/Delete/@e.Id" class="btn-add"
                                       style="padding:5px 12px;font-size:13px;background:#dc3545;" title="Delete">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9">
                            <div class="empty-state">
                                <i class="fas fa-receipt"></i>
                                <h4>No Expenses Found</h4>
                                <p>Click "New Expense" to record your first expense.</p>
                                <a href="/Expense/Create" class="btn-add" style="margin-top:12px;display:inline-flex;padding:8px 20px;font-size:13px;">
                                    <i class="fas fa-plus"></i> New Expense
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>