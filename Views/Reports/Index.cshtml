@{
    ViewData["Title"] = "Reports & Analytics";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <div class="left">
        <h1><span class="icon">📊</span> Reports & Analytics</h1>
    </div>
</div>

<!-- Date Range Filter -->
<div class="card-custom mb-4">
    <form method="get" asp-action="Index" style="display:flex;gap:12px;flex-wrap:wrap;align-items:end;">
        <div style="min-width:160px;">
            <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">From</label>
            <input type="date" name="fromDate" value="@ViewBag.FromDate"
                   style="width:100%;padding:8px 12px;border:1px solid #ddd;border-radius:6px;" />
        </div>
        <div style="min-width:160px;">
            <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">To</label>
            <input type="date" name="toDate" value="@ViewBag.ToDate"
                   style="width:100%;padding:8px 12px;border:1px solid #ddd;border-radius:6px;" />
        </div>
        <div style="display:flex;gap:8px;">
            <button type="submit" class="btn-add"><i class="fas fa-chart-line"></i> Apply</button>
            <a href="/Reports" class="btn-back"><i class="fas fa-redo"></i> Reset</a>
        </div>
    </form>
</div>

<!-- Quick Links -->
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px;margin-bottom:20px;">
    <a href="/Reports/Sales" class="card-custom" style="text-decoration:none;color:inherit;padding:16px;">
        <div style="display:flex;align-items:center;gap:12px;">
            <span style="font-size:28px;color:var(--primary);"><i class="fas fa-shopping-cart"></i></span>
            <div>
                <div style="font-weight:700;font-size:15px;">Sales Report</div>
                <div style="font-size:12px;color:var(--text-muted);">Revenue & orders</div>
            </div>
        </div>
    </a>
    <a href="/Reports/Inventory" class="card-custom" style="text-decoration:none;color:inherit;padding:16px;">
        <div style="display:flex;align-items:center;gap:12px;">
            <span style="font-size:28px;color:var(--secondary);"><i class="fas fa-boxes"></i></span>
            <div>
                <div style="font-weight:700;font-size:15px;">Inventory Report</div>
                <div style="font-size:12px;color:var(--text-muted);">Stock levels & value</div>
            </div>
        </div>
    </a>
    <a href="/Reports/Expenses" class="card-custom" style="text-decoration:none;color:inherit;padding:16px;">
        <div style="display:flex;align-items:center;gap:12px;">
            <span style="font-size:28px;color:#f4a261;"><i class="fas fa-receipt"></i></span>
            <div>
                <div style="font-weight:700;font-size:15px;">Expense Report</div>
                <div style="font-size:12px;color:var(--text-muted);">Spending analysis</div>
            </div>
        </div>
    </a>
    <a href="/Reports/Customers" class="card-custom" style="text-decoration:none;color:inherit;padding:16px;">
        <div style="display:flex;align-items:center;gap:12px;">
            <span style="font-size:28px;color:#28a745;"><i class="fas fa-users"></i></span>
            <div>
                <div style="font-weight:700;font-size:15px;">Customer Report</div>
                <div style="font-size:12px;color:var(--text-muted);">Performance & balances</div>
            </div>
        </div>
    </a>
</div>

<!-- Main KPI Cards -->
<div class="kpi-grid">
    <div class="kpi-card">
        <span class="kpi-icon"><i class="fas fa-chart-line"></i></span>
        <div class="kpi-label">Total Sales</div>
        <div class="kpi-value">₱@ViewBag.TotalSales.ToString("N0")</div>
        <div class="kpi-change positive">@ViewBag.OrderCount orders</div>
    </div>
    <div class="kpi-card" style="border-left-color:#28a745;">
        <span class="kpi-icon" style="color:#28a745;"><i class="fas fa-arrow-down"></i></span>
        <div class="kpi-label">Received</div>
        <div class="kpi-value">₱@ViewBag.TotalReceived.ToString("N0")</div>
        <div class="kpi-change positive">Customer payments</div>
    </div>
    <div class="kpi-card" style="border-left-color:#f4a261;">
        <span class="kpi-icon" style="color:#f4a261;"><i class="fas fa-file-invoice-dollar"></i></span>
        <div class="kpi-label">Outstanding</div>
        <div class="kpi-value">₱@ViewBag.Outstanding.ToString("N0")</div>
        <div class="kpi-change negative">Unpaid balance</div>
    </div>
    <div class="kpi-card" style="border-left-color:#dc3545;">
        <span class="kpi-icon" style="color:#dc3545;"><i class="fas fa-arrow-up"></i></span>
        <div class="kpi-label">Expenses</div>
        <div class="kpi-value">₱@ViewBag.TotalExpenses.ToString("N0")</div>
        <div class="kpi-change negative">Operating costs</div>
    </div>
</div>

<div class="kpi-grid" style="margin-top:-8px;">
    <div class="kpi-card" style="border-left-color:@(ViewBag.NetCashFlow >= 0 ? "#28a745" : "#dc3545");">
        <span class="kpi-icon" style="color:@(ViewBag.NetCashFlow >= 0 ? "#28a745" : "#dc3545");">
            <i class="fas fa-coins"></i>
        </span>
        <div class="kpi-label">Net Cash Flow</div>
        <div class="kpi-value">₱@ViewBag.NetCashFlow.ToString("N0")</div>
        <div class="kpi-change @(ViewBag.NetCashFlow >= 0 ? "positive" : "negative")">
            Received − Paid − Expenses
        </div>
    </div>
    <div class="kpi-card" style="border-left-color:var(--secondary);">
        <span class="kpi-icon" style="color:var(--secondary);"><i class="fas fa-boxes"></i></span>
        <div class="kpi-label">Inventory Value</div>
        <div class="kpi-value">₱@ViewBag.InventoryValue.ToString("N0")</div>
        <div class="kpi-change positive">@ViewBag.LowStockCount low-stock</div>
    </div>
    <div class="kpi-card" style="border-left-color:#6c757d;">
        <span class="kpi-icon" style="color:#6c757d;"><i class="fas fa-shopping-bag"></i></span>
        <div class="kpi-label">Avg Order Value</div>
        <div class="kpi-value">₱@ViewBag.AvgOrderValue.ToString("N0")</div>
        <div class="kpi-change positive">Per order</div>
    </div>
    <div class="kpi-card" style="border-left-color:#6c757d;">
        <span class="kpi-icon" style="color:#6c757d;"><i class="fas fa-hand-holding-usd"></i></span>
        <div class="kpi-label">Supplier Paid</div>
        <div class="kpi-value">₱@ViewBag.TotalSupplierPaid.ToString("N0")</div>
        <div class="kpi-change negative">Purchases</div>
    </div>
</div>

<!-- Charts -->
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(400px,1fr));gap:16px;margin-top:16px;">
    <div class="card-custom" style="padding:20px;">
        <h3 style="font-size:15px;margin-bottom:16px;">Monthly Sales Trend</h3>
        <div class="chart-container">
            <canvas id="salesChart"></canvas>
        </div>
    </div>
    <div class="card-custom" style="padding:20px;">
        <h3 style="font-size:15px;margin-bottom:16px;">Expenses by Category</h3>
        <div class="chart-container">
            <canvas id="expensesChart"></canvas>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Monthly Sales Trend
            var salesCtx = document.getElementById('salesChart');
            if (salesCtx) {
                new Chart(salesCtx, {
                    type: 'line',
                    data: {
                        labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.MonthlySalesLabels)),
                        datasets: [{
                            label: 'Sales (₱)',
                            data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.MonthlySalesValues)),
                            borderColor: '#0d6e3e',
                            backgroundColor: 'rgba(13, 110, 62, 0.1)',
                            tension: 0.3,
                            fill: true,
                            borderWidth: 3
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    callback: v => '₱' + v.toLocaleString()
                                }
                            }
                        }
                    }
                });
            }

            // Expenses by Category
            var expCtx = document.getElementById('expensesChart');
            if (expCtx) {
                new Chart(expCtx, {
                    type: 'doughnut',
                    data: {
                        labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ExpenseCategoryLabels)),
                        datasets: [{
                            data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ExpenseCategoryValues)),
                            backgroundColor: [
                                '#0d6e3e', '#12a5da', '#f4a261', '#e76f51',
                                '#79c25c', '#6c757d', '#ffc107', '#dc3545'
                            ]
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { position: 'bottom' }
                        }
                    }
                });
            }
        });
    </script>
}