@model IEnumerable<FarmFlow.Web.Models.Crop>
@{
    ViewData["Title"] = "Crop Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var crops = Model.ToList();
}

<!-- Header -->
<div class="page-header">
    <div class="left">
        <h1><span class="icon">🌱</span> Crop Management</h1>
    </div>
    <a href="/Crop/Create" class="btn-add">
        <i class="fas fa-plus"></i> Add Crop
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert-success-custom">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
    </div>
}

<!-- KPI Cards -->
<div class="kpi-grid">
    <div class="kpi-card">
        <span class="kpi-icon"><i class="fas fa-seedling"></i></span>
        <div class="kpi-label">Total Crops</div>
        <div class="kpi-value">@crops.Count</div>
        <div class="kpi-change positive"><i class="fas fa-arrow-up"></i> In Catalog</div>
    </div>
    <div class="kpi-card" style="border-left-color:var(--primary-light);">
        <span class="kpi-icon" style="color:var(--primary-light);"><i class="fas fa-check-circle"></i></span>
        <div class="kpi-label">Active Crops</div>
        <div class="kpi-value">@crops.Count(c => c.IsActive)</div>
        <div class="kpi-change positive"><i class="fas fa-check"></i> Available</div>
    </div>
    <div class="kpi-card" style="border-left-color:var(--secondary);">
        <span class="kpi-icon" style="color:var(--secondary);"><i class="fas fa-clock"></i></span>
        <div class="kpi-label">Avg. Days to Harvest</div>
        <div class="kpi-value">@(crops.Any() ? ((int)crops.Where(c => c.GrowthDurationDays.HasValue).Average(c => c.GrowthDurationDays ?? 0)).ToString() : "0")</div>
        <div class="kpi-change positive"><i class="fas fa-calendar"></i> Days</div>
    </div>
    <div class="kpi-card" style="border-left-color:#f4a261;">
        <span class="kpi-icon" style="color:#f4a261;"><i class="fas fa-tags"></i></span>
        <div class="kpi-label">Categories</div>
        <div class="kpi-value">@crops.Select(c => c.Category).Distinct().Count()</div>
        <div class="kpi-change positive"><i class="fas fa-th-large"></i> Types</div>
    </div>
</div>

<!-- Filter Card -->
<div class="card-custom mb-4">
    <form method="get" asp-action="Index" style="display:flex;gap:12px;flex-wrap:wrap;align-items:end;">
        <div style="flex:1;min-width:200px;">
            <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">Search</label>
            <div class="input-wrapper">
                <i class="fas fa-search icon"></i>
                <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" placeholder="Search by crop name..." />
            </div>
        </div>
        <div style="display:flex;gap:8px;">
            <button type="submit" class="btn-add">
                <i class="fas fa-search"></i> Filter
            </button>
            <a href="/Crop" class="btn-back">
                <i class="fas fa-redo"></i> Reset
            </a>
        </div>
    </form>
</div>

<!-- Table -->
<div class="card-custom">
    <div class="table-wrapper">
        <table class="table-custom">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Crop Name</th>
                    <th>Variety</th>
                    <th>Category</th>
                    <th>Days to Harvest</th>
                    <th>Yield (kg/ha)</th>
                    <th>Season</th>
                    <th>Status</th>
                    <th style="text-align:center;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (crops.Any())
                {
                    foreach (var crop in crops)
                    {
                        <tr>
                            <td><span class="badge-status info">@crop.CropCode</span></td>
                            <td><strong>@crop.CropName</strong></td>
                            <td>@(crop.Variety ?? "-")</td>
                            <td>
                                @if (!string.IsNullOrEmpty(crop.Category))
                                {
                                    <span class="badge-status secondary">@crop.Category</span>
                                }
                                else
                                {
                                    <span style="color:var(--text-muted);">-</span>
                                }
                            </td>
                            <td>@(crop.GrowthDurationDays?.ToString() ?? "-") days</td>
                            <td><strong>@(crop.ExpectedYieldPerHectare?.ToString("N0") ?? "-")</strong></td>
                            <td>@(crop.Season ?? "-")</td>
                            <td>
                                @if (crop.IsActive)
                                {
                                    <span class="badge-status active">Active</span>
                                }
                                else
                                {
                                    <span class="badge-status inactive">Inactive</span>
                                }
                            </td>
                            <td style="text-align:center;white-space:nowrap;">
                                <a href="/Crop/Edit/@crop.Id" class="btn-add" style="padding:5px 12px;font-size:13px;background:#ffc107;color:#212529;" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a href="/Crop/Delete/@crop.Id" class="btn-add" style="padding:5px 12px;font-size:13px;background:#dc3545;" title="Delete">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9">
                            <div class="empty-state">
                                <i class="fas fa-seedling"></i>
                                <h4>No Crops Found</h4>
                                <p>Click "Add Crop" to create your first crop variety.</p>
                                <a href="/Crop/Create" class="btn-add" style="margin-top:12px;display:inline-flex;padding:8px 20px;font-size:13px;">
                                    <i class="fas fa-plus"></i> Add First Crop
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>