@model FarmFlow.Web.Models.Quotation
@{
    ViewData["Title"] = "New Quotation";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <div class="left">
        <h1><span class="icon">📄</span> New Quotation</h1>
    </div>
    <a href="/Quotation" class="btn-back">
        <i class="fas fa-arrow-left"></i> Back to List
    </a>
</div>

<div class="card-custom" style="padding:24px;">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" style="color:#dc3545;margin-bottom:12px;"></div>

        <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:16px;">
            <div>
                <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">Quotation # *</label>
                <input asp-for="QuotationNumber" readonly
                       style="width:100%;padding:8px 12px;border:1px solid #ddd;border-radius:6px;background:#f8f9fa;" />
                <span asp-validation-for="QuotationNumber" style="color:#dc3545;font-size:12px;"></span>
            </div>
            <div>
                <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">Customer *</label>
                <select asp-for="CustomerId" asp-items="ViewBag.Customers"
                        style="width:100%;padding:8px 12px;border:1px solid #ddd;border-radius:6px;">
                    <option value="">-- Select Customer --</option>
                </select>
                <span asp-validation-for="CustomerId" style="color:#dc3545;font-size:12px;"></span>
            </div>
            <div>
                <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">Quotation Date</label>
                <input asp-for="QuotationDate" type="date"
                       value="@DateTime.Now.ToString("yyyy-MM-dd")"
                       style="width:100%;padding:8px 12px;border:1px solid #ddd;border-radius:6px;" />
            </div>
            <div>
                <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">Valid Until</label>
                <input asp-for="ValidUntilDate" type="date"
                       value="@DateTime.Now.AddDays(30).ToString("yyyy-MM-dd")"
                       style="width:100%;padding:8px 12px;border:1px solid #ddd;border-radius:6px;" />
            </div>
            <div>
                <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">Status</label>
                <select asp-for="Status" style="width:100%;padding:8px 12px;border:1px solid #ddd;border-radius:6px;">
                    <option value="Draft">Draft</option>
                    <option value="Sent">Sent</option>
                    <option value="Accepted">Accepted</option>
                    <option value="Rejected">Rejected</option>
                </select>
            </div>
            <div>
                <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">Sales Rep</label>
                <select asp-for="SalesRepId" asp-items="ViewBag.SalesReps"
                        style="width:100%;padding:8px 12px;border:1px solid #ddd;border-radius:6px;">
                    <option value="">-- None --</option>
                </select>
            </div>
            <div>
                <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">Subtotal (₱)</label>
                <input asp-for="SubtotalAmount" type="number" step="0.01" value="0"
                       style="width:100%;padding:8px 12px;border:1px solid #ddd;border-radius:6px;" />
            </div>
            <div>
                <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">Tax (₱)</label>
                <input asp-for="TaxAmount" type="number" step="0.01" value="0"
                       style="width:100%;padding:8px 12px;border:1px solid #ddd;border-radius:6px;" />
            </div>
            <div style="grid-column:1/-1;">
                <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">Total (₱)</label>
                <input asp-for="TotalAmount" type="number" step="0.01" value="0"
                       style="width:100%;padding:8px 12px;border:1px solid #ddd;border-radius:6px;font-weight:600;" />
                <small style="color:var(--text-muted);font-size:12px;">Typically Subtotal + Tax.</small>
            </div>
            <div style="grid-column:1/-1;">
                <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">Notes</label>
                <textarea asp-for="Notes" rows="3"
                          style="width:100%;padding:8px 12px;border:1px solid #ddd;border-radius:6px;"></textarea>
            </div>
        </div>

        <div style="margin-top:24px;display:flex;gap:10px;">
            <button type="submit" class="btn-add"><i class="fas fa-save"></i> Save Quotation</button>
            <a href="/Quotation" class="btn-back"><i class="fas fa-times"></i> Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}