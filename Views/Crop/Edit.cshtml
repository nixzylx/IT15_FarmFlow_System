@model FarmFlow.Web.Models.Crop
@{
    ViewData["Title"] = "Edit Crop - FarmFlow";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', sans-serif; background: #f0f4f0; padding: 40px 20px; }
        .container { max-width: 700px; margin: 0 auto; background: white; border-radius: 16px; padding: 40px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); }
        h1 { color: #1a472a; margin-bottom: 10px; }
        .subtitle { color: #888; margin-bottom: 30px; }
        .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
        .form-group { margin-bottom: 20px; }
        .form-group label { display: block; font-weight: 600; margin-bottom: 5px; color: #333; }
        .form-group input, .form-group select { width: 100%; padding: 10px 14px; border: 2px solid #e8ece8; border-radius: 8px; font-size: 14px; background: #f8faf8; }
        .form-group input:focus, .form-group select:focus { border-color: #2d6a4f; background: white; outline: none; }
        .form-group input[readonly] { background: #e9ecef; cursor: not-allowed; }
        .form-group .text-danger { color: #dc3545; font-size: 13px; margin-top: 4px; display: block; }
        .validation-summary { background: #f8d7da; color: #721c24; padding: 12px 16px; border-radius: 8px; margin-bottom: 20px; border: 1px solid #f5c6cb; }
        .validation-summary ul { margin: 0; padding-left: 20px; }
        .btn-group { display: flex; gap: 10px; margin-top: 20px; }
        .btn-submit { background: #1a472a; color: white; border: none; padding: 12px 30px; border-radius: 8px; cursor: pointer; font-weight: 600; font-size: 16px; }
        .btn-submit:hover { background: #2d6a4f; }
        .btn-cancel { background: #6c757d; color: white; border: none; padding: 12px 30px; border-radius: 8px; cursor: pointer; font-weight: 600; text-decoration: none; display: inline-block; }
        .btn-cancel:hover { background: #5a6268; }
        .required { color: #dc3545; }
        .checkbox-group { display: flex; align-items: center; gap: 10px; }
        .checkbox-group input[type="checkbox"] { width: 18px; height: 18px; accent-color: #1a472a; }
        .checkbox-group label { margin: 0; cursor: pointer; }
        @@media (max-width: 600px) { .form-row { grid-template-columns: 1fr; } }
    </style>
</head>
<body>
    <div class="container">
        <h1>Edit Crop</h1>
        <p class="subtitle">Update crop details.</p>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="validation-summary">
                <ul>
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        <form method="post" asp-action="Edit">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" value="@Model?.Id" />
            <input type="hidden" name="CreatedDateTime" value="@Model?.CreatedDateTime" />

            <div class="form-row">
                <div class="form-group">
                    <label>Crop Name <span class="required">*</span></label>
                    <input type="text" id="CropName" name="CropName" value="@Model?.CropName" required />
                </div>
                <div class="form-group">
                    <label>Variety</label>
                    <input type="text" id="Variety" name="Variety" value="@Model?.Variety" placeholder="e.g., Roma, Jasmine" />
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Crop Code</label>
                    <input type="text" id="CropCode" name="CropCode" value="@Model?.CropCode" readonly />
                </div>
                <div class="form-group">
                    <label>Category</label>
                    <select id="Category" name="Category">
                        <option value="">Select Category...</option>
                        <option value="Vegetable" selected="@(Model?.Category == "Vegetable")">Vegetable</option>
                        <option value="Fruit" selected="@(Model?.Category == "Fruit")">Fruit</option>
                        <option value="Grain" selected="@(Model?.Category == "Grain")">Grain</option>
                        <option value="Legume" selected="@(Model?.Category == "Legume")">Legume</option>
                        <option value="Root" selected="@(Model?.Category == "Root")">Root</option>
                        <option value="Herb" selected="@(Model?.Category == "Herb")">Herb</option>
                        <option value="Other" selected="@(Model?.Category == "Other")">Other</option>
                    </select>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Growth Duration (Days)</label>
                    <input type="number" id="GrowthDurationDays" name="GrowthDurationDays" value="@Model?.GrowthDurationDays" placeholder="e.g., 75" />
                </div>
                <div class="form-group">
                    <label>Expected Yield (kg/ha)</label>
                    <input type="number" id="ExpectedYieldPerHectare" name="ExpectedYieldPerHectare" value="@Model?.ExpectedYieldPerHectare" step="0.01" />
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Unit of Measure</label>
                    <select id="UnitOfMeasure" name="UnitOfMeasure">
                        <option value="">Select Unit...</option>
                        <option value="kg" selected="@(Model?.UnitOfMeasure == "kg")">kg</option>
                        <option value="tons" selected="@(Model?.UnitOfMeasure == "tons")">tons</option>
                        <option value="pieces" selected="@(Model?.UnitOfMeasure == "pieces")">pieces</option>
                        <option value="bunches" selected="@(Model?.UnitOfMeasure == "bunches")">bunches</option>
                        <option value="liters" selected="@(Model?.UnitOfMeasure == "liters")">liters</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Season</label>
                    <select id="Season" name="Season">
                        <option value="">Select Season...</option>
                        <option value="Wet" selected="@(Model?.Season == "Wet")">Wet Season</option>
                        <option value="Dry" selected="@(Model?.Season == "Dry")">Dry Season</option>
                        <option value="Year-round" selected="@(Model?.Season == "Year-round")">Year-round</option>
                    </select>
                </div>
            </div>

            <div class="form-group">
                <div class="checkbox-group">
                    <input type="checkbox" id="IsActive" name="IsActive" value="true" checked="@(Model?.IsActive == true)" />
                    <label for="IsActive">Active Crop</label>
                </div>
            </div>

            <div class="btn-group">
                <button type="submit" class="btn-submit">
                    <i class="fas fa-save"></i> Update Crop
                </button>
                <a href="/Crop" class="btn-cancel">
                    <i class="fas fa-times"></i> Cancel
                </a>
            </div>
        </form>
    </div>
</body>
</html>