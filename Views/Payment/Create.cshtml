@model FarmFlow.Web.Models.Payment
@{
    ViewData["Title"] = "Record Payment";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var methods = Enum.GetValues(typeof(FarmFlow.Web.Models.PaymentMethod)).Cast<FarmFlow.Web.Models.PaymentMethod>();
    bool isCustomer = Model.PaymentType == "Customer";
}

<div class="page-header">
    <div class="left">
        <h1><span class="icon">💳</span> Record Payment</h1>
    </div>
    <a href="/Payment" class="btn-back">
        <i class="fas fa-arrow-left"></i> Back to List
    </a>
</div>

<div class="card-custom" style="padding:24px;">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" style="color:#dc3545;margin-bottom:12px;"></div>

        <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:16px;">
            <div>
                <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">Payment # *</label>
                <input asp-for="PaymentNumber" readonly
                       style="width:100%;padding:8px 12px;border:1px solid #ddd;border-radius:6px;background:#f8f9fa;" />
                <span asp-validation-for="PaymentNumber" style="color:#dc3545;font-size:12px;"></span>
            </div>
            <div>
                <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">Payment Date *</label>
                <input asp-for="PaymentDate" type="date" value="@DateTime.Now.ToString("yyyy-MM-dd")"
                       style="width:100%;padding:8px 12px;border:1px solid #ddd;border-radius:6px;" />
                <span asp-validation-for="PaymentDate" style="color:#dc3545;font-size:12px;"></span>
            </div>
            <div>
                <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">Payment Type *</label>
                <select asp-for="PaymentType" id="paymentTypeSelect"
                        style="width:100%;padding:8px 12px;border:1px solid #ddd;border-radius:6px;">
                    <option value="Customer" selected="@(Model.PaymentType == "Customer")">Customer Payment (Inflow)</option>
                    <option value="Supplier" selected="@(Model.PaymentType == "Supplier")">Supplier Payment (Outflow)</option>
                </select>
            </div>
            <div>
                <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">Amount (₱) *</label>
                <input asp-for="Amount" type="number" step="0.01" min="0"
                       style="width:100%;padding:8px 12px;border:1px solid #ddd;border-radius:6px;" />
                <span asp-validation-for="Amount" style="color:#dc3545;font-size:12px;"></span>
            </div>

            <!-- Sales Order section (Customer) -->
            <div class="customer-section" style="grid-column:1/-1;@(isCustomer ? "" : "display:none;")">
                <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">Sales Order *</label>
                <select asp-for="SalesOrderId" asp-items="ViewBag.SalesOrders"
                        style="width:100%;padding:8px 12px;border:1px solid #ddd;border-radius:6px;">
                    <option value="">-- Select Sales Order --</option>
                </select>
                <span asp-validation-for="SalesOrderId" style="color:#dc3545;font-size:12px;"></span>
            </div>

            <!-- Purchase Order section (Supplier) -->
            <div class="supplier-section" style="grid-column:1/-1;@(isCustomer ? "display:none;" : "")">
                <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">Purchase Order *</label>
                <select asp-for="PurchaseOrderId" asp-items="ViewBag.PurchaseOrders"
                        style="width:100%;padding:8px 12px;border:1px solid #ddd;border-radius:6px;">
                    <option value="">-- Select Purchase Order --</option>
                </select>
                <span asp-validation-for="PurchaseOrderId" style="color:#dc3545;font-size:12px;"></span>
            </div>

            <div>
                <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">Payment Method *</label>
                <select asp-for="PaymentMethod" style="width:100%;padding:8px 12px;border:1px solid #ddd;border-radius:6px;">
                    @foreach (var m in methods)
                    {
                        <option value="@m" selected="@(Model.PaymentMethod == m)">@m</option>
                    }
                </select>
            </div>
            <div>
                <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">Reference # (Check #, GCash ref)</label>
                <input asp-for="ReferenceNumber" style="width:100%;padding:8px 12px;border:1px solid #ddd;border-radius:6px;" />
            </div>
            <div style="grid-column:1/-1;">
                <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">Notes</label>
                <textarea asp-for="Notes" rows="3"
                          placeholder="Any additional details about this payment..."
                          style="width:100%;padding:8px 12px;border:1px solid #ddd;border-radius:6px;"></textarea>
            </div>
        </div>

        <div style="margin-top:24px;display:flex;gap:10px;">
            <button type="submit" class="btn-add"><i class="fas fa-save"></i> Save Payment</button>
            <a href="/Payment" class="btn-back"><i class="fas fa-times"></i> Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const typeSelect = document.getElementById('paymentTypeSelect');
            const customerSection = document.querySelector('.customer-section');
            const supplierSection = document.querySelector('.supplier-section');

            function toggleSections() {
                const isCustomer = typeSelect.value === 'Customer';
                customerSection.style.display = isCustomer ? 'block' : 'none';
                supplierSection.style.display = isCustomer ? 'none' : 'block';
            }

            typeSelect.addEventListener('change', toggleSections);
            toggleSections();
        });
    </script>
}