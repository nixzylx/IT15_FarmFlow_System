@model FarmFlow.Web.Models.SalesOrder
@{
    ViewData["Title"] = $"Sales Order {Model.SONumber}";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var statusClass = Model.Status switch
    {
        "Confirmed" => "info",
        "Picking" => "secondary",
        "Dispatched" => "secondary",
        "Delivered" => "active",
        "Cancelled" => "inactive",
        _ => "secondary"
    };
    var payClass = Model.PaymentStatus switch
    {
        "Paid" => "active",
        "Partial" => "secondary",
        _ => "inactive"
    };
}

<div class="page-header">
    <div class="left">
        <h1><span class="icon">🛒</span> @Model.SONumber</h1>
    </div>
    <div style="display:flex;gap:8px;">
        <a href="/SalesOrder" class="btn-back"><i class="fas fa-arrow-left"></i> Back</a>

        @if (Model.Status == "Confirmed" || Model.Status == "Picking")
        {
            <form asp-action="Dispatch" asp-route-id="@Model.Id" method="post" style="display:inline;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-add" style="background:#ffc107;color:#212529;"
                        onclick="return confirm('Mark this order as Dispatched?');">
                    <i class="fas fa-truck"></i> Dispatch
                </button>
            </form>
        }

        @if (Model.Status == "Dispatched")
        {
            <form asp-action="Deliver" asp-route-id="@Model.Id" method="post" style="display:inline;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-add" style="background:#28a745;"
                        onclick="return confirm('Deliver this order? Stock will be deducted.');">
                    <i class="fas fa-check"></i> Deliver
                </button>
            </form>
        }

        @if (Model.Status != "Delivered" && Model.Status != "Cancelled")
        {
            <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" style="display:inline;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-add" style="background:#dc3545;"
                        onclick="return confirm('Cancel this order?');">
                    <i class="fas fa-ban"></i> Cancel
                </button>
            </form>
        }
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert-success-custom">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
    </div>
}

<div class="kpi-grid">
    <div class="kpi-card">
        <span class="kpi-icon"><i class="fas fa-calendar-alt"></i></span>
        <div class="kpi-label">Order Date</div>
        <div class="kpi-value" style="font-size:20px;">@Model.OrderDate.ToString("MMM dd, yyyy")</div>
    </div>
    <div class="kpi-card" style="border-left-color:var(--primary-light);">
        <span class="kpi-icon" style="color:var(--primary-light);"><i class="fas fa-truck"></i></span>
        <div class="kpi-label">Required Delivery</div>
        <div class="kpi-value" style="font-size:20px;">@(Model.RequiredDeliveryDate?.ToString("MMM dd, yyyy") ?? "-")</div>
    </div>
    <div class="kpi-card" style="border-left-color:#28a745;">
        <span class="kpi-icon" style="color:#28a745;"><i class="fas fa-money-bill-wave"></i></span>
        <div class="kpi-label">Total</div>
        <div class="kpi-value">₱@((Model.TotalAmount ?? 0).ToString("N0"))</div>
    </div>
    <div class="kpi-card" style="border-left-color:#f4a261;">
        <span class="kpi-icon" style="color:#f4a261;"><i class="fas fa-file-invoice-dollar"></i></span>
        <div class="kpi-label">Payment</div>
        <div class="kpi-value" style="font-size:20px;"><span class="badge-status @payClass">@Model.PaymentStatus</span></div>
    </div>
</div>

<div class="card-custom" style="padding:24px;margin-bottom:16px;">
    <h3 style="margin-bottom:16px;font-size:16px;">Order Information</h3>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;">
        <div><strong>SO #:</strong> @Model.SONumber</div>
        <div><strong>Customer:</strong> @(Model.Customer?.CompanyName ?? "-")</div>
        <div><strong>Sales Rep:</strong> @(Model.SalesRep?.FirstName ?? "-")</div>
        <div><strong>Order Date:</strong> @Model.OrderDate.ToString("MMM dd, yyyy")</div>
        <div><strong>Required Delivery:</strong> @(Model.RequiredDeliveryDate?.ToString("MMM dd, yyyy") ?? "-")</div>
        <div><strong>Actual Delivery:</strong> @(Model.ActualDeliveryDate?.ToString("MMM dd, yyyy") ?? "-")</div>
        <div>
            <strong>Status:</strong>
            <span class="badge-status @statusClass">@Model.Status</span>
        </div>
        <div>
            <strong>Payment:</strong>
            <span class="badge-status @payClass">@Model.PaymentStatus</span>
        </div>
        <div><strong>Created:</strong> @Model.CreatedDateTime.ToString("MMM dd, yyyy")</div>
    </div>
</div>

<div class="card-custom" style="padding:24px;margin-bottom:16px;">
    <h3 style="margin-bottom:16px;font-size:16px;">Amount Breakdown</h3>
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:16px;">
        <div><strong>Subtotal:</strong> ₱@((Model.SubtotalAmount ?? 0).ToString("N2"))</div>
        <div><strong>Discount:</strong> -₱@((Model.DiscountAmount ?? 0).ToString("N2"))</div>
        <div><strong>Tax:</strong> ₱@((Model.TaxAmount ?? 0).ToString("N2"))</div>
        <div><strong>Total:</strong> <span style="font-weight:700;color:var(--primary);">₱@((Model.TotalAmount ?? 0).ToString("N2"))</span></div>
    </div>
</div>

<div class="card-custom" style="margin-bottom:16px;">
    <div style="padding:16px 20px;border-bottom:1px solid #eee;">
        <h3 style="font-size:16px;margin:0;">Order Items</h3>
    </div>
    <div class="table-wrapper">
        <table class="table-custom">
            <thead>
                <tr>
    <th>Item</th>
    <th>Qty Ordered</th>
    <th>Qty Delivered</th>
    <th>Unit Price</th>
    <th>Line Total</th>
</tr>
            </thead>
            <tbody>
                @if (Model.SalesOrderItems != null && Model.SalesOrderItems.Any())
                {
                    foreach (var item in Model.SalesOrderItems)
                    {
                        <tr>
    <td>@(item.InventoryItem?.ItemName ?? $"Item #{item.InventoryItemId}")</td>
    <td>@item.QuantityOrdered @(item.InventoryItem?.UnitOfMeasure ?? "")</td>
    <td>@item.QuantityDelivered @(item.InventoryItem?.UnitOfMeasure ?? "")</td>
    <td>₱@item.UnitPrice.ToString("N2")</td>
    <td><strong>₱@item.TotalLineAmount.ToString("N2")</strong></td>
</tr>
                    }
                }
                else
                {
                    <tr><td colspan="5" style="text-align:center;color:var(--text-muted);">No items.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.DeliveryInstructions) || !string.IsNullOrEmpty(Model.Notes))
{
    <div class="card-custom" style="padding:24px;">
        <h3 style="margin-bottom:16px;font-size:16px;">Delivery & Notes</h3>
        @if (!string.IsNullOrEmpty(Model.DeliveryInstructions))
        {
            <div style="margin-bottom:12px;"><strong>Delivery Instructions:</strong> @Model.DeliveryInstructions</div>
        }
        @if (!string.IsNullOrEmpty(Model.Notes))
        {
            <div><strong>Notes:</strong> @Model.Notes</div>
        }
    </div>
}