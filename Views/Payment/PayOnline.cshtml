@model FarmFlow.Web.Models.SalesOrder
@{
    ViewData["Title"] = "Pay Online";
    Layout = "~/Views/Shared/_Layout.cshtml";
    decimal balance = ViewBag.BalanceDue ?? 0;
}

<div class="page-header">
    <div class="left">
        <h1><span class="icon">💳</span> Pay Online</h1>
    </div>
    <a href="/SalesOrder/Details/@Model.Id" class="btn-back">
        <i class="fas fa-arrow-left"></i> Back to Order
    </a>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert-danger-custom" style="background:#f8d7da;color:#721c24;padding:12px 18px;border-radius:8px;margin-bottom:16px;">
        <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
    </div>
}

<div class="card-custom" style="padding:24px;max-width:600px;">
    <h3 style="margin-bottom:16px;font-size:16px;">Order Summary</h3>
    <div style="background:#f8f9fa;padding:16px;border-radius:8px;margin-bottom:20px;">
        <div style="margin-bottom:6px;"><strong>SO #:</strong> @Model.SONumber</div>
        <div style="margin-bottom:6px;"><strong>Customer:</strong> @(Model.Customer?.CompanyName ?? "-")</div>
        <div style="margin-bottom:6px;"><strong>Order Total:</strong> ₱@((Model.TotalAmount ?? 0).ToString("N2"))</div>
        <div style="margin-bottom:6px;"><strong>Already Paid:</strong> ₱@(((Model.TotalAmount ?? 0) - balance).ToString("N2"))</div>
        <div style="font-size:16px;">
            <strong>Balance Due:</strong>
            <span style="color:#dc3545;font-weight:700;">₱@balance.ToString("N2")</span>
        </div>
    </div>

    <form asp-action="CreateOnlinePayment" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="salesOrderId" value="@Model.Id" />

        <div style="margin-bottom:16px;">
            <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">Amount to Pay (₱)</label>
            <input type="number" name="amount" value="@balance.ToString("F2")" min="1" max="@balance" step="0.01"
                   style="width:100%;padding:10px 12px;border:1px solid #ddd;border-radius:6px;font-size:16px;font-weight:600;" />
            <small style="color:var(--text-muted);font-size:12px;">Default is the full balance. You may enter a smaller amount for partial payment.</small>
        </div>

        <div style="background:#e3f2fd;padding:12px 16px;border-radius:8px;margin-bottom:20px;font-size:13px;color:#0c5460;">
            <i class="fas fa-info-circle"></i>
            You will be redirected to <strong>PayMongo</strong> to complete payment via
            <strong>GCash, Maya, Card, or Online Banking</strong>.
        </div>

        <div style="display:flex;gap:10px;">
            <button type="submit" class="btn-add" style="background:#28a745;">
                <i class="fas fa-arrow-right"></i> Proceed to PayMongo
            </button>
            <a href="/SalesOrder/Details/@Model.Id" class="btn-back">
                <i class="fas fa-times"></i> Cancel
            </a>
        </div>
    </form>
</div>