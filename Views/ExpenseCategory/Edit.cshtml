@model FarmFlow.Web.Models.ExpenseCategory
@{
    ViewData["Title"] = "Edit Expense Category";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <div class="left">
        <h1><span class="icon">✏️</span> Edit Expense Category</h1>
    </div>
    <a href="/ExpenseCategory" class="btn-back">
        <i class="fas fa-arrow-left"></i> Back to List
    </a>
</div>

<div class="card-custom" style="padding:24px;max-width:700px;">
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="CreatedDateTime" />
        <div asp-validation-summary="ModelOnly" style="color:#dc3545;margin-bottom:12px;"></div>

        <div style="display:grid;gap:16px;">
            <div>
                <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">Category Name *</label>
                <input asp-for="Name" style="width:100%;padding:8px 12px;border:1px solid #ddd;border-radius:6px;" />
                <span asp-validation-for="Name" style="color:#dc3545;font-size:12px;"></span>
            </div>
            <div>
                <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">Description</label>
                <textarea asp-for="Description" rows="3"
                          style="width:100%;padding:8px 12px;border:1px solid #ddd;border-radius:6px;"></textarea>
            </div>
            <div>
                <label style="display:flex;align-items:center;gap:8px;font-size:14px;">
                    <input asp-for="IsActive" type="checkbox" />
                    <span>Active Category</span>
                </label>
            </div>
        </div>

        <div style="margin-top:24px;display:flex;gap:10px;">
            <button type="submit" class="btn-add"><i class="fas fa-save"></i> Update Category</button>
            <a href="/ExpenseCategory" class="btn-back"><i class="fas fa-times"></i> Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}