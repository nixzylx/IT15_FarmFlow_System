@model IEnumerable<FarmFlow.Web.Models.CrmInteraction>
@{
    ViewData["Title"] = "CRM Interactions";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var interactions = Model.ToList();
    var customers = ViewBag.Customers as List<FarmFlow.Web.Models.Customer> ?? new();
    int? selectedCustomerId = ViewBag.CustomerId as int?;
}

<!-- Header -->
<div class="page-header">
    <div class="left">
        <h1><span class="icon">💬</span> CRM Interactions</h1>
    </div>
    <a href="/Crm/Create" class="btn-add">
        <i class="fas fa-plus"></i> Log Interaction
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert-success-custom">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
    </div>
}

<!-- KPI Cards -->
<div class="kpi-grid">
    <div class="kpi-card">
        <span class="kpi-icon"><i class="fas fa-comments"></i></span>
        <div class="kpi-label">Total Interactions</div>
        <div class="kpi-value">@ViewBag.TotalInteractions</div>
        <div class="kpi-change positive"><i class="fas fa-arrow-up"></i> Logged</div>
    </div>
    <div class="kpi-card" style="border-left-color:var(--primary-light);">
        <span class="kpi-icon" style="color:var(--primary-light);"><i class="fas fa-folder-open"></i></span>
        <div class="kpi-label">Open</div>
        <div class="kpi-value">@ViewBag.OpenCount</div>
        <div class="kpi-change positive">Needs Follow-up</div>
    </div>
    <div class="kpi-card" style="border-left-color:#28a745;">
        <span class="kpi-icon" style="color:#28a745;"><i class="fas fa-check-circle"></i></span>
        <div class="kpi-label">Resolved</div>
        <div class="kpi-value">@ViewBag.ResolvedCount</div>
        <div class="kpi-change positive">Closed</div>
    </div>
    <div class="kpi-card" style="border-left-color:var(--secondary);">
        <span class="kpi-icon" style="color:var(--secondary);"><i class="fas fa-users"></i></span>
        <div class="kpi-label">Unique Customers</div>
        <div class="kpi-value">@interactions.Select(i => i.CustomerId).Distinct().Count()</div>
        <div class="kpi-change positive">Engaged</div>
    </div>
</div>

<!-- Filter Card -->
<div class="card-custom mb-4">
    <form method="get" asp-action="Index" style="display:flex;gap:12px;flex-wrap:wrap;align-items:end;">
        <div style="flex:1;min-width:240px;">
            <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">Customer</label>
            <select name="customerId" style="width:100%;padding:8px 12px;border:1px solid #ddd;border-radius:6px;">
                <option value="">All Customers</option>
                @foreach (var c in customers)
                {
                    <option value="@c.Id" selected="@(selectedCustomerId == c.Id)">@c.CompanyName</option>
                }
            </select>
        </div>
        <div style="display:flex;gap:8px;">
            <button type="submit" class="btn-add"><i class="fas fa-search"></i> Filter</button>
            <a href="/Crm" class="btn-back"><i class="fas fa-redo"></i> Reset</a>
        </div>
    </form>
</div>

<!-- Table -->
<div class="card-custom">
    <div class="table-wrapper">
        <table class="table-custom">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Customer</th>
                    <th>Type</th>
                    <th>Subject</th>
                    <th>Sales Rep</th>
                    <th>Next Follow-up</th>
                    <th>Status</th>
                    <th style="text-align:center;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (interactions.Any())
                {
                    foreach (var i in interactions)
                    {
                        var displayName = !string.IsNullOrEmpty(i.Customer?.CompanyName)
                            ? i.Customer!.CompanyName
                            : $"{i.Customer?.FirstName} {i.Customer?.LastName}".Trim();
                        var isOverdue = i.NextFollowUpDate.HasValue
                            && i.NextFollowUpDate.Value.Date < DateTime.Now.Date
                            && !i.IsResolved;

                        var typeClass = i.InteractionType switch
                        {
                            "Complaint" => "inactive",
                            "Follow-up" => "secondary",
                            "Meeting" => "info",
                            _ => "secondary"
                        };

                        <tr>
                            <td>@i.InteractionDate.ToString("MMM dd, yyyy")</td>
                            <td><strong>@(string.IsNullOrEmpty(displayName) ? "-" : displayName)</strong></td>
                            <td><span class="badge-status @typeClass">@i.InteractionType</span></td>
                            <td>@(i.Subject ?? "-")</td>
                            <td>@(i.SalesRep?.FirstName ?? "-")</td>
                            <td>
                                @if (i.NextFollowUpDate.HasValue)
                                {
                                    if (isOverdue)
                                    {
                                        <span style="color:#dc3545;font-weight:600;">
                                            <i class="fas fa-exclamation-triangle"></i>
                                            @i.NextFollowUpDate.Value.ToString("MMM dd, yyyy")
                                        </span>
                                    }
                                    else
                                    {
                                        <span>@i.NextFollowUpDate.Value.ToString("MMM dd, yyyy")</span>
                                    }
                                }
                                else
                                {
                                    <span style="color:var(--text-muted);">-</span>
                                }
                            </td>
                            <td>
                                @if (i.IsResolved)
                                {
                                    <span class="badge-status active">Resolved</span>
                                }
                                else
                                {
                                    <span class="badge-status info">Open</span>
                                }
                            </td>
                            <td style="text-align:center;white-space:nowrap;">
                                <a href="/Crm/Edit/@i.Id" class="btn-add"
                                   style="padding:5px 12px;font-size:13px;background:#ffc107;color:#212529;" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a href="/Crm/Delete/@i.Id" class="btn-add"
                                   style="padding:5px 12px;font-size:13px;background:#dc3545;" title="Delete">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8">
                            <div class="empty-state">
                                <i class="fas fa-comments"></i>
                                <h4>No Interactions Found</h4>
                                <p>Click "Log Interaction" to record your first customer interaction.</p>
                                <a href="/Crm/Create" class="btn-add" style="margin-top:12px;display:inline-flex;padding:8px 20px;font-size:13px;">
                                    <i class="fas fa-plus"></i> Log Interaction
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>