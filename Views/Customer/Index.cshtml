@model IEnumerable<FarmFlow.Web.Models.Customer>
@{
    ViewData["Title"] = "Customer Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var customers = Model.ToList();
    decimal totalCredit = customers.Sum(c => c.CreditLimit ?? 0);
    decimal totalBalance = customers.Sum(c => c.CurrentBalance ?? 0);
}

<!-- Header -->
<div class="page-header">
    <div class="left">
        <h1><span class="icon">👥</span> Customer Management</h1>
    </div>
    <a href="/Customer/Create" class="btn-add">
        <i class="fas fa-plus"></i> Add Customer
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert-success-custom">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert-danger-custom" style="background:#f8d7da;color:#721c24;padding:12px 18px;border-radius:8px;margin-bottom:16px;">
        <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
    </div>
}

<!-- KPI Cards -->
<div class="kpi-grid">
    <div class="kpi-card">
        <span class="kpi-icon"><i class="fas fa-users"></i></span>
        <div class="kpi-label">Total Customers</div>
        <div class="kpi-value">@customers.Count</div>
        <div class="kpi-change positive"><i class="fas fa-arrow-up"></i> Registered</div>
    </div>
    <div class="kpi-card" style="border-left-color:var(--primary-light);">
        <span class="kpi-icon" style="color:var(--primary-light);"><i class="fas fa-check-circle"></i></span>
        <div class="kpi-label">Active</div>
        <div class="kpi-value">@customers.Count(c => c.IsActive)</div>
        <div class="kpi-change positive"><i class="fas fa-check"></i> Buying</div>
    </div>
    <div class="kpi-card" style="border-left-color:var(--secondary);">
        <span class="kpi-icon" style="color:var(--secondary);"><i class="fas fa-hand-holding-usd"></i></span>
        <div class="kpi-label">Total Credit Limit</div>
        <div class="kpi-value">₱@totalCredit.ToString("N0")</div>
        <div class="kpi-change positive"><i class="fas fa-chart-line"></i> Extended</div>
    </div>
    <div class="kpi-card" style="border-left-color:#f4a261;">
        <span class="kpi-icon" style="color:#f4a261;"><i class="fas fa-file-invoice-dollar"></i></span>
        <div class="kpi-label">Outstanding</div>
        <div class="kpi-value">₱@totalBalance.ToString("N0")</div>
        <div class="kpi-change negative">Receivables</div>
    </div>
</div>

<!-- Filter Card -->
<div class="card-custom mb-4">
    <form method="get" asp-action="Index" style="display:flex;gap:12px;flex-wrap:wrap;align-items:end;">
        <div style="flex:1;min-width:200px;">
            <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">Search</label>
            <div class="input-wrapper">
                <i class="fas fa-search icon"></i>
                <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" placeholder="Search by name, code, or email..." />
            </div>
        </div>
        <div style="min-width:160px;">
            <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">Type</label>
            <select name="customerType" style="width:100%;padding:8px 12px;border:1px solid #ddd;border-radius:6px;">
                <option value="">All Types</option>
                <option value="Wholesaler" selected="@(ViewBag.CustomerType == "Wholesaler")">Wholesaler</option>
                <option value="Retailer" selected="@(ViewBag.CustomerType == "Retailer")">Retailer</option>
                <option value="Exporter" selected="@(ViewBag.CustomerType == "Exporter")">Exporter</option>
                <option value="Individual" selected="@(ViewBag.CustomerType == "Individual")">Individual</option>
            </select>
        </div>
        <div style="display:flex;gap:8px;">
            <button type="submit" class="btn-add">
                <i class="fas fa-search"></i> Filter
            </button>
            <a href="/Customer" class="btn-back">
                <i class="fas fa-redo"></i> Reset
            </a>
        </div>
    </form>
</div>

<!-- Table -->
<div class="card-custom">
    <div class="table-wrapper">
        <table class="table-custom">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Customer</th>
                    <th>Type</th>
                    <th>Contact</th>
                    <th>Payment Terms</th>
                    <th>Credit Limit</th>
                    <th>Balance</th>
                    <th>Sales Rep</th>
                    <th>Status</th>
                    <th style="text-align:center;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (customers.Any())
                {
                    foreach (var c in customers)
                    {
                        var displayName = !string.IsNullOrEmpty(c.CompanyName)
                            ? c.CompanyName
                            : $"{c.FirstName} {c.LastName}".Trim();
                        var balance = c.CurrentBalance ?? 0;
                        <tr>
                            <td><span class="badge-status info">@c.CustomerCode</span></td>
                            <td>
                                <strong>@displayName</strong>
                                @if (!string.IsNullOrEmpty(c.CompanyName) && !string.IsNullOrEmpty(c.FirstName))
                                {
                                    <div style="font-size:12px;color:var(--text-muted);">@c.FirstName @c.LastName</div>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(c.CustomerType))
                                {
                                    <span class="badge-status secondary">@c.CustomerType</span>
                                }
                                else
                                {
                                    <span style="color:var(--text-muted);">-</span>
                                }
                            </td>
                            <td>
                                <div>@(c.Email ?? "-")</div>
                                <div style="font-size:12px;color:var(--text-muted);">@(c.PhoneNumber ?? "-")</div>
                            </td>
                            <td>@(c.PaymentTerms ?? "-")</td>
                            <td><strong>₱@((c.CreditLimit ?? 0).ToString("N2"))</strong></td>
                            <td>
                                @if (balance > 0)
                                {
                                    <span style="color:#dc3545;font-weight:600;">₱@balance.ToString("N2")</span>
                                }
                                else
                                {
                                    <span style="color:var(--text-muted);">₱0.00</span>
                                }
                            </td>
                            <td>@(c.AssignedSalesRep?.FirstName ?? "-")</td>
                            <td>
                                @if (c.IsActive)
                                {
                                    <span class="badge-status active">Active</span>
                                }
                                else
                                {
                                    <span class="badge-status inactive">Inactive</span>
                                }
                            </td>
                            <td style="text-align:center;white-space:nowrap;">
                                <a href="/Customer/Details/@c.Id" class="btn-add" style="padding:5px 12px;font-size:13px;background:#17a2b8;" title="View">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="/Customer/Edit/@c.Id" class="btn-add" style="padding:5px 12px;font-size:13px;background:#ffc107;color:#212529;" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a href="/Customer/Delete/@c.Id" class="btn-add" style="padding:5px 12px;font-size:13px;background:#dc3545;" title="Delete">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="10">
                            <div class="empty-state">
                                <i class="fas fa-users"></i>
                                <h4>No Customers Found</h4>
                                <p>Click "Add Customer" to register your first customer.</p>
                                <a href="/Customer/Create" class="btn-add" style="margin-top:12px;display:inline-flex;padding:8px 20px;font-size:13px;">
                                    <i class="fas fa-plus"></i> Add First Customer
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>