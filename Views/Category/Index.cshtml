@model IEnumerable<FarmFlow.Web.Models.Category>
@{
    ViewData["Title"] = "Categories";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <div class="left">
        <a href="/Inventory" class="btn-back">
            <i class="fas fa-arrow-left"></i> Back
        </a>
        <h1><span class="icon">🏷️</span> Categories</h1>
    </div>
    <a href="/Category/Create" class="btn-add">
        <i class="fas fa-plus"></i> Add Category
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert-success-custom">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
    </div>
}

<!-- KPI Card -->
<div class="kpi-grid">
    <div class="kpi-card">
        <span class="kpi-icon"><i class="fas fa-tags"></i></span>
        <div class="kpi-label">Total Categories</div>
        <div class="kpi-value">@(Model?.Count() ?? 0)</div>
        <div class="kpi-change positive"><i class="fas fa-th-large"></i> Item Groups</div>
    </div>
    <div class="kpi-card" style="border-left-color:var(--primary-light);">
        <span class="kpi-icon"><i class="fas fa-check-circle"></i></span>
        <div class="kpi-label">Active</div>
        <div class="kpi-value">@(Model?.Count(c => c.IsActive) ?? 0)</div>
        <div class="kpi-change positive">Available for Use</div>
    </div>
    <div class="kpi-card" style="border-left-color:#e76f51;">
        <span class="kpi-icon" style="color:#e76f51;"><i class="fas fa-times-circle"></i></span>
        <div class="kpi-label">Inactive</div>
        <div class="kpi-value">@(Model?.Count(c => !c.IsActive) ?? 0)</div>
        <div class="kpi-change negative">Not in Use</div>
    </div>
</div>

<!-- Categories Table -->
<div class="card-custom">
    <div class="table-wrapper">
        <table class="table-custom">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Category Name</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th style="text-align:center;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var cat in Model)
                    {
                        <tr>
                            <td>@cat.Id</td>
                            <td>
                                <div style="display:flex;align-items:center;gap:8px;">
                                    <span style="font-size:20px;">🏷️</span>
                                    <strong>@cat.Name</strong>
                                </div>
                            </td>
                            <td>@(cat.Description ?? "-")</td>
                            <td>
                                @if (cat.IsActive)
                                {
                                    <span class="badge-status active">Active</span>
                                }
                                else
                                {
                                    <span class="badge-status inactive">Inactive</span>
                                }
                            </td>
                            <td style="text-align:center;white-space:nowrap;">
                                <a href="/Category/Edit/@cat.Id" class="btn-add" style="padding:5px 12px;font-size:13px;background:#ffc107;color:#212529;" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a href="/Category/Delete/@cat.Id" class="btn-add" style="padding:5px 12px;font-size:13px;background:#dc3545;" title="Delete">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5">
                            <div class="empty-state">
                                <i class="fas fa-tags"></i>
                                <h4>No Categories Found</h4>
                                <p>Click "Add Category" to create your first category.</p>
                                <a href="/Category/Create" class="btn-add" style="margin-top:15px;display:inline-flex;">
                                    <i class="fas fa-plus"></i> Add First Category
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>