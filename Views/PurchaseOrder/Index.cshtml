@model IEnumerable<FarmFlow.Web.Models.PurchaseOrder>
@{
    ViewData["Title"] = "Purchase Orders";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var orders = Model.ToList();
}

<div class="page-header">
    <div class="left">
        <h1><span class="icon">📄</span> Purchase Orders</h1>
    </div>
    <a href="/PurchaseOrder/Create" class="btn-add">
        <i class="fas fa-plus"></i> Create PO
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert-success-custom">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert-danger-custom">
        <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
    </div>
}

<!-- KPI Cards -->
<div class="kpi-grid">
    <div class="kpi-card">
        <span class="kpi-icon"><i class="fas fa-file-invoice"></i></span>
        <div class="kpi-label">Total POs</div>
        <div class="kpi-value">@ViewBag.TotalOrders</div>
        <div class="kpi-change positive"><i class="fas fa-arrow-up"></i> All Time</div>
    </div>
    <div class="kpi-card" style="border-left-color:#f4a261;">
        <span class="kpi-icon" style="color:#f4a261;"><i class="fas fa-clock"></i></span>
        <div class="kpi-label">Pending</div>
        <div class="kpi-value">@ViewBag.PendingCount</div>
        <div class="kpi-change negative">Awaiting Approval</div>
    </div>
    <div class="kpi-card" style="border-left-color:var(--secondary);">
        <span class="kpi-icon" style="color:var(--secondary);"><i class="fas fa-truck"></i></span>
        <div class="kpi-label">In Transit</div>
        <div class="kpi-value">@ViewBag.SentCount</div>
        <div class="kpi-change positive">Sent / Shipped</div>
    </div>
    <div class="kpi-card" style="border-left-color:var(--primary-light);">
        <span class="kpi-icon" style="color:var(--primary-light);"><i class="fas fa-money-bill-wave"></i></span>
        <div class="kpi-label">Total Value</div>
        <div class="kpi-value">₱@ViewBag.TotalValue.ToString("N0")</div>
        <div class="kpi-change positive">Purchases</div>
    </div>
</div>

<!-- Filter Card -->
<div class="card-custom mb-4">
    <form method="get" asp-action="Index" style="display:flex;gap:12px;flex-wrap:wrap;align-items:end;">
        <div style="flex:1;min-width:200px;">
            <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">Search</label>
            <div class="input-wrapper">
                <i class="fas fa-search icon"></i>
                <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" placeholder="Search PO number or supplier..." />
            </div>
        </div>
        <div style="min-width:180px;">
            <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">Status</label>
            <div class="input-wrapper">
                <i class="fas fa-filter icon"></i>
                <select name="status">
                    <option value="">All Statuses</option>
                    <option value="Draft" selected="@(ViewBag.Status == "Draft")">Draft</option>
                    <option value="Pending Approval" selected="@(ViewBag.Status == "Pending Approval")">Pending Approval</option>
                    <option value="Sent" selected="@(ViewBag.Status == "Sent")">Sent</option>
                    <option value="Shipped" selected="@(ViewBag.Status == "Shipped")">Shipped</option>
                    <option value="Received" selected="@(ViewBag.Status == "Received")">Received</option>
                    <option value="Cancelled" selected="@(ViewBag.Status == "Cancelled")">Cancelled</option>
                </select>
            </div>
        </div>
        <div style="display:flex;gap:8px;">
            <button type="submit" class="btn-add"><i class="fas fa-search"></i> Filter</button>
            <a href="/PurchaseOrder" class="btn-back"><i class="fas fa-redo"></i> Reset</a>
        </div>
    </form>
</div>

<!-- Table -->
<div class="card-custom">
    <div class="table-wrapper">
        <table class="table-custom">
            <thead>
                <tr>
                    <th>PO Number</th>
                    <th>Supplier</th>
                    <th>Order Date</th>
                    <th>Expected Delivery</th>
                    <th>Total Amount</th>
                    <th>Status</th>
                    <th style="text-align:center;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (orders.Any())
                {
                    foreach (var po in orders)
                    {
                        var statusClass = po.Status switch
                        {
                            "Draft" => "badge-status secondary",
                            "Pending Approval" => "badge-status warning",
                            "Sent" => "badge-status info",
                            "Shipped" => "badge-status primary",
                            "Received" => "badge-status active",
                            "Cancelled" => "badge-status inactive",
                            _ => "badge-status secondary"
                        };
                        <tr>
                            <td><strong>@po.PONumber</strong></td>
                            <td>@po.Supplier?.CompanyName</td>
                            <td>@po.OrderDate.ToString("MMM dd, yyyy")</td>
                            <td>@(po.DeliveryExpectedDate?.ToString("MMM dd, yyyy") ?? "-")</td>
                            <td><strong>₱@(po.TotalAmount?.ToString("N2") ?? "0.00")</strong></td>
                            <td><span class="@statusClass">@po.Status</span></td>
                            <td style="text-align:center;white-space:nowrap;">
                                <a href="/PurchaseOrder/Details/@po.Id" class="btn-add" style="padding:5px 10px;font-size:13px;background:#17a2b8;" title="View">
                                    <i class="fas fa-eye"></i>
                                </a>
                                @if (po.Status == "Draft" || po.Status == "Pending Approval")
                                {
                                    <a href="/PurchaseOrder/Edit/@po.Id" class="btn-add" style="padding:5px 10px;font-size:13px;background:#ffc107;color:#212529;" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                }
                                <a href="/PurchaseOrder/Delete/@po.Id" class="btn-add" style="padding:5px 10px;font-size:13px;background:#dc3545;" title="Delete">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7">
                            <div class="empty-state">
                                <i class="fas fa-file-invoice"></i>
                                <h4>No Purchase Orders</h4>
                                <p>Click "Create PO" to start purchasing.</p>
                                <a href="/PurchaseOrder/Create" class="btn-add" style="margin-top:12px;display:inline-flex;padding:8px 20px;font-size:13px;">
                                    <i class="fas fa-plus"></i> Create First PO
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>