@model FarmFlow.Web.Models.PurchaseOrder
@{
    ViewData["Title"] = "Edit Purchase Order";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var suppliers = ViewBag.Suppliers as List<FarmFlow.Web.Models.Supplier>;
    var items = ViewBag.Items as List<FarmFlow.Web.Models.InventoryItem>;
    var poItems = Model.PurchaseOrderItems?.ToList() ?? new List<FarmFlow.Web.Models.PurchaseOrderItem>();
}

<div class="page-header">
    <div class="left">
        <a href="/PurchaseOrder" class="btn-back">
            <i class="fas fa-arrow-left"></i> Back
        </a>
        <h1><span class="icon">✏️</span> Edit Purchase Order</h1>
    </div>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="validation-summary">
        <ul>
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}

<form method="post" asp-action="Edit" id="poForm">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Id" value="@Model.Id" />

    <div class="card-custom mb-4">
        <div class="card-header-custom" style="margin-bottom:20px;">
            <h5><i class="fas fa-info-circle" style="color:var(--primary);margin-right:8px;"></i> Purchase Order Details</h5>
        </div>

        <div class="form-row-custom">
            <div class="form-group-custom">
                <label>PO Number</label>
                <div class="input-wrapper">
                    <i class="fas fa-file-invoice icon"></i>
                    <input type="text" value="@Model.PONumber" readonly style="background:#e9ecef;" />
                </div>
            </div>
            <div class="form-group-custom">
                <label>Supplier <span class="required">*</span></label>
                <div class="input-wrapper">
                    <i class="fas fa-truck icon"></i>
                    <select name="SupplierId" required>
                        <option value="">Select Supplier...</option>
                        @foreach (var s in suppliers)
                        {
                            <option value="@s.Id" selected="@(Model.SupplierId == s.Id)">@s.CompanyName (@s.SupplierCode)</option>
                        }
                    </select>
                </div>
            </div>
        </div>

        <div class="form-row-custom">
            <div class="form-group-custom">
                <label>Expected Delivery Date</label>
                <div class="input-wrapper">
                    <i class="fas fa-calendar-alt icon"></i>
                    <input type="date" name="DeliveryExpectedDate" value="@(Model.DeliveryExpectedDate?.ToString("yyyy-MM-dd"))" />
                </div>
            </div>
            <div class="form-group-custom">
                <label>Payment Terms</label>
                <div class="input-wrapper">
                    <i class="fas fa-handshake icon"></i>
                    <select name="PaymentTerms">
                        <option value="">Select Terms...</option>
                        <option value="Net 15" selected="@(Model.PaymentTerms == "Net 15")">Net 15</option>
                        <option value="Net 30" selected="@(Model.PaymentTerms == "Net 30")">Net 30</option>
                        <option value="Net 60" selected="@(Model.PaymentTerms == "Net 60")">Net 60</option>
                        <option value="COD" selected="@(Model.PaymentTerms == "COD")">COD</option>
                        <option value="Prepaid" selected="@(Model.PaymentTerms == "Prepaid")">Prepaid</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="form-group-custom">
            <label>Notes</label>
            <div class="input-wrapper">
                <i class="fas fa-comment icon"></i>
                <input type="text" name="Notes" value="@Model.Notes" placeholder="Additional instructions..." />
            </div>
        </div>
    </div>

    <!-- Items Section -->
    <div class="card-custom mb-4">
        <div class="card-header-custom" style="margin-bottom:20px;">
            <h5><i class="fas fa-boxes" style="color:var(--secondary);margin-right:8px;"></i> Order Items</h5>
            <button type="button" class="btn-add" onclick="addRow()" style="background:var(--secondary);">
                <i class="fas fa-plus"></i> Add Item
            </button>
        </div>

        <div class="table-wrapper">
            <table class="table-custom" id="itemsTable">
                <thead>
                    <tr>
                        <th style="width:40%;">Item</th>
                        <th style="width:15%;">Quantity</th>
                        <th style="width:20%;">Unit Price (₱)</th>
                        <th style="width:20%;">Subtotal (₱)</th>
                        <th style="width:5%;"></th>
                    </tr>
                </thead>
                <tbody id="itemsBody">
                    @if (poItems.Any())
                    {
                        foreach (var poItem in poItems)
                        {
                            <tr class="item-row">
                                <td>
                                    <select name="itemIds" class="form-control item-select" onchange="updateSubtotal(this)">
                                        <option value="">Select Item...</option>
                                        @foreach (var item in items)
                                        {
                                            <option value="@item.Id" selected="@(poItem.InventoryItemId == item.Id)" data-price="@item.CostPerUnit">
                                                @item.ItemName (@item.ItemCode)
                                            </option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <input type="number" name="quantities" class="form-control qty-input" step="0.01" value="@poItem.QuantityOrdered" onchange="updateSubtotal(this)" />
                                </td>
                                <td>
                                    <input type="number" name="unitPrices" class="form-control price-input" step="0.01" value="@poItem.UnitPrice" onchange="updateSubtotal(this)" />
                                </td>
                                <td>
                                    <span class="subtotal">₱@((poItem.QuantityOrdered * poItem.UnitPrice).ToString("N2"))</span>
                                </td>
                                <td>
                                    <button type="button" class="btn-add" style="padding:5px 10px;background:#dc3545;" onclick="removeRow(this)">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr class="item-row">
                            <td>
                                <select name="itemIds" class="form-control item-select" onchange="updateSubtotal(this)">
                                    <option value="">Select Item...</option>
                                    @foreach (var item in items)
                                    {
                                        <option value="@item.Id" data-price="@item.CostPerUnit">@item.ItemName (@item.ItemCode)</option>
                                    }
                                </select>
                            </td>
                            <td><input type="number" name="quantities" class="form-control qty-input" step="0.01" value="1" onchange="updateSubtotal(this)" /></td>
                            <td><input type="number" name="unitPrices" class="form-control price-input" step="0.01" value="0" onchange="updateSubtotal(this)" /></td>
                            <td><span class="subtotal">₱0.00</span></td>
                            <td>
                                <button type="button" class="btn-add" style="padding:5px 10px;background:#dc3545;" onclick="removeRow(this)">
                                    <i class="fas fa-times"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div style="text-align:right;margin-top:20px;padding-top:20px;border-top:2px solid #f0f4f0;">
            <div style="font-size:18px;font-weight:700;">
                Total: <span id="grandTotal" style="color:var(--primary-dark);">₱@(Model.TotalAmount?.ToString("N2") ?? "0.00")</span>
            </div>
        </div>
    </div>

    <div style="display:flex;gap:12px;flex-wrap:wrap;">
        <button type="submit" class="btn-submit">
            <i class="fas fa-save"></i> Update PO
        </button>
        <a href="/PurchaseOrder" class="btn-cancel">
            <i class="fas fa-times"></i> Cancel
        </a>
    </div>
</form>

@section Scripts {
    <script>
        function addRow() {
            const tbody = document.getElementById('itemsBody');
            const firstRow = tbody.querySelector('.item-row');
            const newRow = firstRow.cloneNode(true);
            newRow.querySelector('.item-select').value = '';
            newRow.querySelector('.qty-input').value = '1';
            newRow.querySelector('.price-input').value = '0';
            newRow.querySelector('.subtotal').textContent = '₱0.00';
            tbody.appendChild(newRow);
        }

        function removeRow(btn) {
            const tbody = document.getElementById('itemsBody');
            if (tbody.querySelectorAll('.item-row').length > 1) {
                btn.closest('.item-row').remove();
                calculateGrandTotal();
            } else {
                alert('At least one item is required.');
            }
        }

        function updateSubtotal(el) {
            const row = el.closest('.item-row');
            const itemSelect = row.querySelector('.item-select');
            const qty = parseFloat(row.querySelector('.qty-input').value) || 0;
            const priceInput = row.querySelector('.price-input');

            if (el === itemSelect && itemSelect.value) {
                const selectedOption = itemSelect.options[itemSelect.selectedIndex];
                const itemPrice = selectedOption.getAttribute('data-price');
                if (itemPrice && parseFloat(itemPrice) > 0 && parseFloat(priceInput.value) === 0) {
                    priceInput.value = parseFloat(itemPrice).toFixed(2);
                }
            }

            const price = parseFloat(priceInput.value) || 0;
            const subtotal = qty * price;
            row.querySelector('.subtotal').textContent = '₱' + subtotal.toFixed(2);
            calculateGrandTotal();
        }

        function calculateGrandTotal() {
            let total = 0;
            document.querySelectorAll('.item-row').forEach(row => {
                const qty = parseFloat(row.querySelector('.qty-input').value) || 0;
                const price = parseFloat(row.querySelector('.price-input').value) || 0;
                total += qty * price;
            });
            document.getElementById('grandTotal').textContent = '₱' + total.toFixed(2);
        }
    </script>
}