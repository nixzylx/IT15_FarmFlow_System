@model FarmFlow.Web.Models.SalesOrder
@{
    ViewData["Title"] = "Delete Sales Order";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <div class="left">
        <h1><span class="icon">⚠️</span> Delete Sales Order</h1>
    </div>
    <a href="/SalesOrder" class="btn-back">
        <i class="fas fa-arrow-left"></i> Back to List
    </a>
</div>

<div class="card-custom" style="padding:24px;max-width:640px;">
    @if (Model.Status == "Delivered")
    {
        <div style="background:#f8d7da;border-left:4px solid #dc3545;padding:12px 16px;border-radius:6px;margin-bottom:20px;">
            <strong style="color:#721c24;"><i class="fas fa-ban"></i> Cannot Delete</strong>
            <p style="margin:6px 0 0 0;color:#721c24;font-size:13px;">
                This Sales Order has already been delivered and stock has been deducted. Cancel or archive it instead.
            </p>
        </div>
        <a href="/SalesOrder/Details/@Model.Id" class="btn-back">
            <i class="fas fa-arrow-left"></i> Back to Details
        </a>
    }
    else
    {
        <div style="background:#fff3cd;border-left:4px solid #ffc107;padding:12px 16px;border-radius:6px;margin-bottom:20px;">
            <strong style="color:#856404;"><i class="fas fa-exclamation-triangle"></i> Warning</strong>
            <p style="margin:6px 0 0 0;color:#856404;font-size:13px;">This action cannot be undone.</p>
        </div>

        <p style="font-size:15px;margin-bottom:16px;">Are you sure you want to delete this Sales Order?</p>

        <div style="background:#f8f9fa;padding:16px;border-radius:8px;margin-bottom:20px;">
            <div style="margin-bottom:6px;"><strong>SO #:</strong> @Model.SONumber</div>
            <div style="margin-bottom:6px;"><strong>Customer:</strong> @(Model.Customer?.CompanyName ?? "-")</div>
            <div style="margin-bottom:6px;"><strong>Order Date:</strong> @Model.OrderDate.ToString("MMM dd, yyyy")</div>
            <div style="margin-bottom:6px;"><strong>Status:</strong> @Model.Status</div>
            <div><strong>Total:</strong> ₱@((Model.TotalAmount ?? 0).ToString("N2"))</div>
        </div>

        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div style="display:flex;gap:10px;">
                <button type="submit" class="btn-add" style="background:#dc3545;"
                        onclick="return confirm('Permanently delete this Sales Order?');">
                    <i class="fas fa-trash"></i> Confirm Delete
                </button>
                <a href="/SalesOrder" class="btn-back"><i class="fas fa-times"></i> Cancel</a>
            </div>
        </form>
    }
</div>