@model FarmFlow.Web.Models.Quotation
@{
    ViewData["Title"] = "Delete Quotation";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var displayName = !string.IsNullOrEmpty(Model.Customer?.CompanyName)
        ? Model.Customer!.CompanyName
        : $"{Model.Customer?.FirstName} {Model.Customer?.LastName}".Trim();
}

<div class="page-header">
    <div class="left">
        <h1><span class="icon">⚠️</span> Delete Quotation</h1>
    </div>
    <a href="/Quotation" class="btn-back">
        <i class="fas fa-arrow-left"></i> Back to List
    </a>
</div>

<div class="card-custom" style="padding:24px;max-width:640px;">
    @if (Model.Status == "Converted" || Model.ConvertedToSOId.HasValue)
    {
        <div style="background:#f8d7da;border-left:4px solid #dc3545;padding:12px 16px;border-radius:6px;margin-bottom:20px;">
            <strong style="color:#721c24;">
                <i class="fas fa-ban"></i> Cannot Delete
            </strong>
            <p style="margin:6px 0 0 0;color:#721c24;font-size:13px;">
                This quotation has already been converted to a Sales Order. Delete the Sales Order first if you must remove this record.
            </p>
        </div>

        <div style="display:flex;gap:10px;">
            <a href="/SalesOrder/Details/@Model.ConvertedToSOId" class="btn-add" style="background:#17a2b8;">
                <i class="fas fa-eye"></i> View Sales Order
            </a>
            <a href="/Quotation" class="btn-back">
                <i class="fas fa-times"></i> Cancel
            </a>
        </div>
    }
    else
    {
        <div style="background:#fff3cd;border-left:4px solid #ffc107;padding:12px 16px;border-radius:6px;margin-bottom:20px;">
            <strong style="color:#856404;">
                <i class="fas fa-exclamation-triangle"></i> Warning
            </strong>
            <p style="margin:6px 0 0 0;color:#856404;font-size:13px;">
                This action cannot be undone.
            </p>
        </div>

        <p style="font-size:15px;margin-bottom:16px;">Are you sure you want to delete this quotation?</p>

        <div style="background:#f8f9fa;padding:16px;border-radius:8px;margin-bottom:20px;">
            <div style="margin-bottom:6px;"><strong>Quotation #:</strong> @Model.QuotationNumber</div>
            <div style="margin-bottom:6px;"><strong>Customer:</strong> @(string.IsNullOrEmpty(displayName) ? "-" : displayName)</div>
            <div style="margin-bottom:6px;"><strong>Date:</strong> @Model.QuotationDate.ToString("MMM dd, yyyy")</div>
            <div style="margin-bottom:6px;"><strong>Status:</strong> @Model.Status</div>
            <div><strong>Total:</strong> ₱@((Model.TotalAmount ?? 0).ToString("N2"))</div>
        </div>

        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div style="display:flex;gap:10px;">
                <button type="submit" class="btn-add" style="background:#dc3545;"
                        onclick="return confirm('Permanently delete this quotation?');">
                    <i class="fas fa-trash"></i> Confirm Delete
                </button>
                <a href="/Quotation" class="btn-back">
                    <i class="fas fa-times"></i> Cancel
                </a>
            </div>
        </form>
    }
</div>