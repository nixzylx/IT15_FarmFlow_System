@model FarmFlow.Web.Models.Customer
@{
    ViewData["Title"] = "Edit Customer";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var reps = ViewBag.SalesReps as List<FarmFlow.Web.Models.User> ?? new List<FarmFlow.Web.Models.User>();
}

<div class="page-header">
    <div class="left">
        <h1><span class="icon">✏️</span> Edit Customer</h1>
    </div>
    <a href="/Customer" class="btn-back">
        <i class="fas fa-arrow-left"></i> Back to List
    </a>
</div>

<div class="card-custom" style="padding:24px;">
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="CreatedDateTime" />
        <div asp-validation-summary="ModelOnly" style="color:#dc3545;margin-bottom:12px;"></div>

        <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:16px;">
            <div>
                <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">Customer Code *</label>
                <input asp-for="CustomerCode" readonly
                       style="width:100%;padding:8px 12px;border:1px solid #ddd;border-radius:6px;background:#f8f9fa;" />
                <span asp-validation-for="CustomerCode" style="color:#dc3545;font-size:12px;"></span>
            </div>
            <div>
                <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">Customer Type</label>
                <select asp-for="CustomerType" style="width:100%;padding:8px 12px;border:1px solid #ddd;border-radius:6px;">
                    <option value="">-- Select --</option>
                    <option value="Retailer">Retailer</option>
                    <option value="Wholesaler">Wholesaler</option>
                    <option value="Exporter">Exporter</option>
                    <option value="Individual">Individual</option>
                </select>
            </div>
            <div style="grid-column:1/-1;">
                <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">Company Name</label>
                <input asp-for="CompanyName" style="width:100%;padding:8px 12px;border:1px solid #ddd;border-radius:6px;" />
            </div>
            <div>
                <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">First Name</label>
                <input asp-for="FirstName" style="width:100%;padding:8px 12px;border:1px solid #ddd;border-radius:6px;" />
            </div>
            <div>
                <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">Last Name</label>
                <input asp-for="LastName" style="width:100%;padding:8px 12px;border:1px solid #ddd;border-radius:6px;" />
            </div>
            <div>
                <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">Email</label>
                <input asp-for="Email" type="email" style="width:100%;padding:8px 12px;border:1px solid #ddd;border-radius:6px;" />
                <span asp-validation-for="Email" style="color:#dc3545;font-size:12px;"></span>
            </div>
            <div>
                <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">Phone Number</label>
                <input asp-for="PhoneNumber" style="width:100%;padding:8px 12px;border:1px solid #ddd;border-radius:6px;" />
            </div>
            <div>
                <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">Tax ID</label>
                <input asp-for="TaxId" style="width:100%;padding:8px 12px;border:1px solid #ddd;border-radius:6px;" />
            </div>
            <div>
                <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">Payment Terms</label>
                <select asp-for="PaymentTerms" style="width:100%;padding:8px 12px;border:1px solid #ddd;border-radius:6px;">
                    <option value="">-- Select --</option>
                    <option value="COD">COD</option>
                    <option value="Net 15">Net 15</option>
                    <option value="Net 30">Net 30</option>
                    <option value="Net 60">Net 60</option>
                </select>
            </div>
            <div>
                <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">Discount Tier</label>
                <select asp-for="DiscountTier" style="width:100%;padding:8px 12px;border:1px solid #ddd;border-radius:6px;">
                    <option value="">-- Select --</option>
                    <option value="Bronze">Bronze</option>
                    <option value="Silver">Silver</option>
                    <option value="Gold">Gold</option>
                </select>
            </div>
            <div>
                <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">Credit Limit (₱)</label>
                <input asp-for="CreditLimit" type="number" step="0.01"
                       style="width:100%;padding:8px 12px;border:1px solid #ddd;border-radius:6px;" />
            </div>
            <div>
                <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">Current Balance (₱)</label>
                <input asp-for="CurrentBalance" type="number" step="0.01"
                       style="width:100%;padding:8px 12px;border:1px solid #ddd;border-radius:6px;" />
            </div>
            <div>
                <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">Assigned Sales Rep</label>
                <select asp-for="AssignedSalesRepId" style="width:100%;padding:8px 12px;border:1px solid #ddd;border-radius:6px;">
                    <option value="">-- None --</option>
                    @foreach (var rep in reps)
                    {
                        <option value="@rep.Id" selected="@(Model.AssignedSalesRepId == rep.Id)">
                            @rep.FirstName @rep.LastName
                        </option>
                    }
                </select>
            </div>
            <div style="grid-column:1/-1;">
                <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">Address</label>
                <textarea asp-for="Address" rows="2"
                          style="width:100%;padding:8px 12px;border:1px solid #ddd;border-radius:6px;"></textarea>
            </div>
            <div style="grid-column:1/-1;">
                <label style="font-size:13px;font-weight:600;display:block;margin-bottom:5px;">Notes</label>
                <textarea asp-for="Notes" rows="3"
                          style="width:100%;padding:8px 12px;border:1px solid #ddd;border-radius:6px;"></textarea>
            </div>
            <div>
                <label style="display:flex;align-items:center;gap:8px;font-size:14px;">
                    <input asp-for="IsActive" type="checkbox" />
                    <span>Active Customer</span>
                </label>
            </div>
        </div>

        <div style="margin-top:24px;display:flex;gap:10px;">
            <button type="submit" class="btn-add">
                <i class="fas fa-save"></i> Update Customer
            </button>
            <a href="/Customer" class="btn-back">
                <i class="fas fa-times"></i> Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}