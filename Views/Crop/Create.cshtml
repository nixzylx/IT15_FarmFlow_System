@model FarmFlow.Web.Models.Crop
@{
    ViewData["Title"] = "Add Crop";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <div class="left">
        <a href="/Crop" class="btn-back">
            <i class="fas fa-arrow-left"></i> Back
        </a>
        <h1><span class="icon">➕</span> Add New Crop</h1>
    </div>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="validation-summary">
        <ul>
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}

<div class="card-custom" style="max-width:900px;margin:0 auto;">

    <div class="card-header-custom" style="margin-bottom:20px;">
        <h5><i class="fas fa-info-circle" style="color:var(--primary);margin-right:8px;"></i> Basic Information</h5>
    </div>

    <form method="post" asp-action="Create">
        @Html.AntiForgeryToken()

        <div class="form-row-custom">
            <div class="form-group-custom">
                <label>Crop Name <span class="required">*</span></label>
                <div class="input-wrapper">
                    <i class="fas fa-seedling icon"></i>
                    <input type="text" name="CropName" value="@Model?.CropName" placeholder="e.g., Tomato" required />
                </div>
            </div>
            <div class="form-group-custom">
                <label>Variety</label>
                <div class="input-wrapper">
                    <i class="fas fa-leaf icon"></i>
                    <input type="text" name="Variety" value="@Model?.Variety" placeholder="e.g., Roma" />
                </div>
            </div>
        </div>

        <div class="form-row-custom">
            <div class="form-group-custom">
                <label>Crop Code</label>
                <div class="input-wrapper">
                    <i class="fas fa-barcode icon"></i>
                    <input type="text" name="CropCode" value="@Model?.CropCode" placeholder="e.g., CROP-001" />
                </div>
            </div>
            <div class="form-group-custom">
                <label>Category</label>
                <div class="input-wrapper">
                    <i class="fas fa-tags icon"></i>
                    <select name="Category">
                        <option value="">Select Category...</option>
                        <option value="Vegetable" selected="@(Model?.Category == "Vegetable")">Vegetable</option>
                        <option value="Fruit" selected="@(Model?.Category == "Fruit")">Fruit</option>
                        <option value="Grain" selected="@(Model?.Category == "Grain")">Grain</option>
                        <option value="Legume" selected="@(Model?.Category == "Legume")">Legume</option>
                        <option value="Root" selected="@(Model?.Category == "Root")">Root</option>
                        <option value="Herb" selected="@(Model?.Category == "Herb")">Herb</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="card-header-custom" style="margin-bottom:20px;margin-top:30px;">
            <h5><i class="fas fa-chart-line" style="color:var(--secondary);margin-right:8px;"></i> Growth Details</h5>
        </div>

        <div class="form-row-custom">
            <div class="form-group-custom">
                <label>Growth Duration (Days)</label>
                <div class="input-wrapper">
                    <i class="fas fa-clock icon"></i>
                    <input type="number" name="GrowthDurationDays" value="@Model?.GrowthDurationDays" placeholder="e.g., 75" />
                </div>
            </div>
            <div class="form-group-custom">
                <label>Expected Yield (kg/ha)</label>
                <div class="input-wrapper">
                    <i class="fas fa-weight-hanging icon"></i>
                    <input type="number" name="ExpectedYieldPerHectare" value="@Model?.ExpectedYieldPerHectare" step="0.01" placeholder="e.g., 15000" />
                </div>
            </div>
        </div>

        <div class="form-row-custom">
            <div class="form-group-custom">
                <label>Unit of Measure</label>
                <div class="input-wrapper">
                    <i class="fas fa-balance-scale icon"></i>
                    <select name="UnitOfMeasure">
                        <option value="">Select Unit...</option>
                        <option value="kg" selected="@(Model?.UnitOfMeasure == "kg")">Kilogram (kg)</option>
                        <option value="tons" selected="@(Model?.UnitOfMeasure == "tons")">Tons</option>
                        <option value="pieces" selected="@(Model?.UnitOfMeasure == "pieces")">Pieces</option>
                        <option value="bunches" selected="@(Model?.UnitOfMeasure == "bunches")">Bunches</option>
                        <option value="liters" selected="@(Model?.UnitOfMeasure == "liters")">Liters</option>
                    </select>
                </div>
            </div>
            <div class="form-group-custom">
                <label>Season</label>
                <div class="input-wrapper">
                    <i class="fas fa-sun icon"></i>
                    <select name="Season">
                        <option value="">Select Season...</option>
                        <option value="Wet" selected="@(Model?.Season == "Wet")">Wet Season</option>
                        <option value="Dry" selected="@(Model?.Season == "Dry")">Dry Season</option>
                        <option value="Year-round" selected="@(Model?.Season == "Year-round")">Year-round</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="form-group-custom">
            <div class="checkbox-group">
                <input type="checkbox" id="IsActive" name="IsActive" value="true" checked />
                <label for="IsActive">Active Crop</label>
            </div>
        </div>

        <div style="display:flex;gap:12px;margin-top:25px;flex-wrap:wrap;">
            <button type="submit" class="btn-submit">
                <i class="fas fa-save"></i> Create Crop
            </button>
            <a href="/Crop" class="btn-cancel">
                <i class="fas fa-times"></i> Cancel
            </a>
        </div>
    </form>
</div>